---
interface Props {
  mountainNames?: string;
}
const { mountainNames = '[]' } = Astro.props;
---

<div class="search-container">
  <div class="search-wrapper" id="search-wrapper">
    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder="Search for mountains by name or location..."
      autocomplete="off"
      aria-label="Search mountains"
      aria-autocomplete="list"
      aria-controls="search-prediction"
      aria-expanded="false"
      role="combobox"
    />
    <button id="near-me-btn" class="near-me-btn" aria-label="Find mountains near me">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      Near Me
    </button>

    <div id="search-prediction" class="search-prediction" role="listbox" aria-label="Search suggestions" hidden>
      <div id="prediction-item" class="prediction-item" role="option" aria-selected="false">
        <svg class="prediction-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <span id="prediction-text" class="prediction-text"></span>
        <span class="prediction-hint">Press Enter</span>
      </div>
      <div id="no-results-item" class="no-results-item" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        No peaks found
      </div>
    </div>
  </div>

  <div class="filters-section" role="group" aria-label="Filter mountains">
    <div class="filter-group">
      <span class="filter-label" id="region-label">Region:</span>
      <div class="filter-chips" role="group" aria-labelledby="region-label">
        <button class="filter-chip region-filter active" data-filter="all" data-type="region">All</button>
        <button class="filter-chip region-filter" data-filter="Scotland" data-type="region">Scotland</button>
        <button class="filter-chip region-filter" data-filter="Wales" data-type="region">Wales</button>
        <button class="filter-chip region-filter" data-filter="England" data-type="region">England</button>
        <button class="filter-chip region-filter" data-filter="Northern Ireland" data-type="region">Northern Ireland</button>
      </div>
    </div>

    <div class="filter-group">
      <span class="filter-label" id="classification-label">Classification:</span>
      <div class="filter-chips" role="group" aria-labelledby="classification-label">
        <button class="filter-chip class-filter active" data-filter="all" data-type="classification">All</button>
        <button class="filter-chip class-filter" data-filter="munro" data-type="classification">Munros</button>
        <button class="filter-chip class-filter" data-filter="corbett" data-type="classification">Corbetts</button>
        <button class="filter-chip class-filter" data-filter="graham" data-type="classification">Grahams</button>
        <button class="filter-chip class-filter" data-filter="wainwright" data-type="classification">Wainwrights</button>
        <button class="filter-chip class-filter" data-filter="hewitt" data-type="classification">Hewitts</button>
        <button class="filter-chip class-filter" data-filter="nuttall" data-type="classification">Nuttalls</button>
        <button class="filter-chip class-filter" data-filter="marilyn" data-type="classification">Marilyns</button>
      </div>
    </div>

    <div class="filter-group">
      <span class="filter-label" id="difficulty-label">Difficulty:</span>
      <div class="filter-chips" role="group" aria-labelledby="difficulty-label">
        <button class="filter-chip diff-filter active" data-filter="all" data-type="difficulty">All</button>
        <button class="filter-chip diff-filter" data-filter="Easy" data-type="difficulty">Easy</button>
        <button class="filter-chip diff-filter" data-filter="Moderate" data-type="difficulty">Moderate</button>
        <button class="filter-chip diff-filter" data-filter="Hard" data-type="difficulty">Hard</button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ mountainNames }}>
  const mountains = JSON.parse(mountainNames);

  const input = document.getElementById('search-input');
  const prediction = document.getElementById('search-prediction');
  const predictionItem = document.getElementById('prediction-item');
  const predictionText = document.getElementById('prediction-text');
  const noResults = document.getElementById('no-results-item');

  let currentMatch = null;

  function findBestMatch(query) {
    if (!query || query.length < 2) return null;
    const lower = query.toLowerCase();
    return mountains.find(name => name.toLowerCase().includes(lower)) || null;
  }

  function showPrediction(match) {
    currentMatch = match;
    predictionText.textContent = match;
    predictionItem.hidden = false;
    noResults.hidden = true;
    prediction.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }

  function showNoResults() {
    currentMatch = null;
    predictionItem.hidden = true;
    noResults.hidden = false;
    prediction.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }

  function hidePrediction() {
    prediction.hidden = true;
    predictionItem.hidden = true;
    noResults.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    currentMatch = null;
  }

  function acceptMatch(matchName) {
    input.value = matchName;
    hidePrediction();
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.focus();
  }

  input.addEventListener('input', () => {
    const val = input.value.trim();
    if (!val || val.length < 2) {
      hidePrediction();
      return;
    }
    const match = findBestMatch(val);
    if (match) {
      showPrediction(match);
    } else {
      showNoResults();
    }
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && currentMatch) {
      e.preventDefault();
      acceptMatch(currentMatch);
    }
    if (e.key === 'Escape') {
      hidePrediction();
    }
  });

  predictionItem.addEventListener('mousedown', (e) => {
    e.preventDefault();
    if (currentMatch) acceptMatch(currentMatch);
  });

  document.addEventListener('click', (e) => {
    if (!input.contains(e.target) && !prediction.contains(e.target)) {
      hidePrediction();
    }
  });
</script>

<style>
  .search-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: white;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    padding: var(--spacing-sm);
    gap: var(--spacing-sm);
    transition: box-shadow var(--transition-base);
  }

  .search-wrapper:focus-within {
    box-shadow: 0 20px 30px -5px rgba(15, 118, 110, 0.3), 0 10px 10px -5px rgba(15, 118, 110, 0.1);
  }

  .search-icon {
    position: absolute;
    left: 20px;
    color: var(--color-neutral-400);
    pointer-events: none;
    z-index: 1;
  }

  .search-input {
    flex: 1;
    padding: 16px 20px 16px 52px;
    border: none;
    font-size: 1rem;
    outline: none;
    background: transparent;
    color: var(--color-neutral-900);
    min-width: 0;
  }

  .search-input::placeholder {
    color: var(--color-neutral-400);
  }

  .near-me-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 12px 20px;
    background-color: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius-lg);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-height: 44px;
    flex-shrink: 0;
  }

  .near-me-btn:hover {
    background-color: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .near-me-btn:active {
    transform: translateY(0);
  }

  .search-prediction {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border: 1px solid var(--color-neutral-200);
    overflow: hidden;
    z-index: 50;
    animation: fadeSlideIn 0.12s ease;
  }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .prediction-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 18px;
    cursor: pointer;
    transition: background var(--transition-fast);
    color: var(--color-neutral-800);
    font-size: 0.975rem;
  }

  .prediction-item:hover {
    background: var(--color-neutral-50);
  }

  .prediction-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .prediction-text {
    flex: 1;
    font-weight: 500;
  }

  .prediction-hint {
    font-size: 0.75rem;
    color: var(--color-neutral-400);
    background: var(--color-neutral-100);
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .no-results-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 18px;
    color: var(--color-neutral-400);
    font-size: 0.9rem;
    font-style: italic;
  }

  .no-results-item svg {
    flex-shrink: 0;
    color: var(--color-neutral-300);
  }

  .filters-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .filter-label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-neutral-700);
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .filter-chip {
    padding: 8px 16px;
    border: 2px solid var(--color-neutral-300);
    background: white;
    color: var(--color-neutral-700);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-height: 44px;
  }

  .filter-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-chip.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  @media (max-width: 768px) {
    .search-wrapper {
      flex-direction: column;
      align-items: stretch;
    }

    .search-input {
      padding: 14px 20px 14px 48px;
    }

    .search-icon {
      left: 16px;
      top: 18px;
    }

    .near-me-btn {
      width: 100%;
      justify-content: center;
    }

    .prediction-hint {
      display: none;
    }

    .filter-chips {
      gap: var(--spacing-xs);
    }

    .filter-chip {
      font-size: 0.8rem;
      padding: 6px 12px;
    }
  }
</style>
