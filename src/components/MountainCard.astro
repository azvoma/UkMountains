---
interface Props {
  mountain: {
    name: string;
    slug: string;
    height_meters: number;
    height_feet: number;
    region: string;
    classification: string | null;
    description: string | null;
    image_url?: string;
  };
}

const { mountain } = Astro.props;
const defaultImage = 'https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=800';
---

<a href={`/mountain/${mountain.slug}`} class="mountain-card" aria-label={`View details for ${mountain.name}, ${mountain.height_meters} meters in ${mountain.region}`}>
  <div class="card-image">
    <img
      src={mountain.image_url || defaultImage}
      alt={`${mountain.name} mountain in ${mountain.region}`}
      loading="lazy"
      width="400"
      height="220"
      onerror={`this.onerror=null;this.src='${defaultImage}'`}
    />
    {mountain.classification && (
      <span class="badge">{mountain.classification}</span>
    )}
  </div>
  <div class="card-content">
    <h3>{mountain.name}</h3>
    <div class="card-meta">
      <span class="meta-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline>
          <polyline points="16 17 22 17 22 11"></polyline>
        </svg>
        {mountain.height_meters}m ({mountain.height_feet}ft)
      </span>
      <span class="meta-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {mountain.region}
      </span>
    </div>
    {mountain.description && (
      <p class="card-description">
        {mountain.description.substring(0, 120)}{mountain.description.length > 120 ? '...' : ''}
      </p>
    )}
  </div>
</a>

<style>
  .mountain-card {
    display: block;
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
    height: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  .mountain-card:focus {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }

  .mountain-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-8px);
  }

  .card-image {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .mountain-card:hover .card-image img {
    transform: scale(1.1);
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 12px;
    background: rgba(15, 118, 110, 0.95);
    color: white;
    border-radius: var(--radius-md);
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .card-content {
    padding: var(--spacing-lg);
  }

  .card-content h3 {
    margin: 0 0 var(--spacing-sm) 0;
    font-size: 1.25rem;
    color: var(--color-neutral-900);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--color-neutral-600);
  }

  .meta-item svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .card-description {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-neutral-600);
  }
</style>
