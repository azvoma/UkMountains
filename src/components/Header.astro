---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class="logo" aria-label="UK Mountains home page">
        <img src="/Main_Logo.png" alt="UK Mountains Directory" class="logo-image" />
      </a>

      <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <ul class="nav-links">
        <li><a href="/" class={currentPath === '/' ? 'active' : ''} aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
        <li class="has-dropdown">
          <a href="/about/" class={currentPath === '/about/' || currentPath.startsWith('/blog/') ? 'active' : ''} aria-current={currentPath === '/about/' ? 'page' : undefined} aria-haspopup="true" aria-expanded="false">About</a>
          <ul class="nav-dropdown">
            <li><a href="/about/" class={currentPath === '/about/' ? 'active' : ''}>About</a></li>
            <li><a href="/blog/" class={currentPath.startsWith('/blog/') ? 'active' : ''}>Blog</a></li>
          </ul>
        </li>
        <li><a href="/mountains/" class={currentPath === '/mountains/' ? 'active' : ''} aria-current={currentPath === '/mountains/' ? 'page' : undefined}>Mountains</a></li>
        <li><a href="/nature-reserves/" class={currentPath === '/nature-reserves/' ? 'active' : ''} aria-current={currentPath === '/nature-reserves/' ? 'page' : undefined}>Nature Reserves</a></li>
        <li class="has-dropdown">
          <a href="/woodland-walks/" class={currentPath === '/woodland-walks/' || currentPath === '/yorkshire-dales-walks/' ? 'active' : ''} aria-current={currentPath === '/woodland-walks/' ? 'page' : undefined} aria-haspopup="true" aria-expanded="false">Woodland Walks</a>
          <ul class="nav-dropdown">
            <li><a href="/woodland-walks/" class={currentPath === '/woodland-walks/' ? 'active' : ''}>Woodland Walks</a></li>
            <li><a href="/yorkshire-dales-walks/" class={currentPath === '/yorkshire-dales-walks/' ? 'active' : ''}>Yorkshire Dales Walks</a></li>
          </ul>
        </li>
        <li><a href="/outdoor-activities/" class={currentPath === '/outdoor-activities/' ? 'active' : ''} aria-current={currentPath === '/outdoor-activities/' ? 'page' : undefined}>Outdoor Activities</a></li>
        <li><a href="/contact/" class={currentPath === '/contact/' ? 'active' : ''} aria-current={currentPath === '/contact/' ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('.nav-links');

  if (menuToggle && navLinks) {
    menuToggle.addEventListener('click', () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isExpanded));
      menuToggle.classList.toggle('active');
      navLinks.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
      if (!menuToggle.contains(e.target as Node) && !navLinks.contains(e.target as Node)) {
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.classList.remove('active');
        navLinks.classList.remove('active');
      }
    });

    const dropdownToggles = navLinks.querySelectorAll('.has-dropdown > a[aria-haspopup]');
    dropdownToggles.forEach((toggle) => {
      toggle.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
          e.preventDefault();
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          if (!expanded) {
            (toggle.nextElementSibling as HTMLElement)?.querySelector('a')?.focus();
          }
        }
      });
    });

    const links = navLinks.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.classList.remove('active');
        navLinks.classList.remove('active');
      });
    });
  }
</script>

<style>
  .header {
    background: white;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md) 0;
    position: relative;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: transform var(--transition-fast);
    z-index: 101;
  }

  .logo:focus {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .logo-image {
    height: 61px;
    width: auto;
    display: block;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
  }

  .menu-toggle span {
    width: 25px;
    height: 3px;
    background-color: var(--color-neutral-900);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--spacing-xl);
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--color-neutral-700);
    font-weight: 500;
    text-decoration: none;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .nav-links a:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .nav-links a:hover {
    color: var(--color-primary);
    background-color: var(--color-neutral-100);
  }

  .nav-links a.active {
    color: var(--color-primary);
    background-color: rgba(15, 118, 110, 0.1);
  }

  .has-dropdown {
    position: relative;
  }

  .has-dropdown > a::after {
    content: '▾';
    font-size: 0.7rem;
    margin-left: 4px;
    opacity: 0.6;
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    list-style: none;
    margin: 0;
    padding: var(--spacing-sm) 0;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-neutral-200);
    min-width: 180px;
    z-index: 102;
  }

  .has-dropdown:hover .nav-dropdown,
  .has-dropdown:focus-within .nav-dropdown {
    display: block;
  }

  .nav-dropdown li {
    width: 100%;
  }

  .nav-dropdown a {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 0.9rem;
    border-radius: 0;
    white-space: nowrap;
  }

  .nav-dropdown a:hover {
    background-color: var(--color-neutral-100);
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      flex-direction: column;
      gap: 0;
      padding: var(--spacing-md) 0;
      box-shadow: var(--shadow-md);
      border-top: 1px solid var(--color-neutral-200);
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }

    .nav-links.active {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links li {
      width: 100%;
    }

    .nav-links a {
      display: block;
      padding: var(--spacing-md) var(--spacing-lg);
      font-size: 1rem;
      border-radius: 0;
    }

    .has-dropdown > a::after {
      display: none;
    }

    .nav-dropdown {
      position: static;
      display: block;
      box-shadow: none;
      border: none;
      padding: 0;
      min-width: 0;
    }

    .nav-dropdown a {
      padding-left: var(--spacing-2xl);
      font-size: 0.95rem;
      color: var(--color-neutral-500);
    }

    .logo-image {
      height: 51px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .nav-links {
      gap: var(--spacing-md);
    }

    .nav-links a {
      padding: var(--spacing-sm);
      font-size: 0.95rem;
    }

    .logo-image {
      height: 55px;
    }
  }
</style>
