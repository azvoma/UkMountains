---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">
        <span class="logo-icon">⛰️</span>
        <span class="logo-text">UK Mountains</span>
      </a>

      <ul class="nav-links">
        <li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
        <li><a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a></li>
        <li><a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background: white;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md) 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .logo:hover {
    transform: scale(1.05);
    color: var(--color-primary);
  }

  .logo-icon {
    font-size: 2rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--spacing-xl);
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--color-neutral-700);
    font-weight: 500;
    text-decoration: none;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .nav-links a:hover {
    color: var(--color-primary);
    background-color: var(--color-neutral-100);
  }

  .nav-links a.active {
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    background-color: rgba(15, 118, 110, 0.1);
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: var(--spacing-md);
    }

    .nav-links a {
      padding: var(--spacing-sm);
      font-size: 0.9rem;
    }

    .logo-text {
      font-size: 1.25rem;
    }

    .logo-icon {
      font-size: 1.5rem;
    }
  }
</style>
