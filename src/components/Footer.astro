---
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h4>UK Mountains Directory</h4>
        <p>Your comprehensive guide to exploring the mountains of the United Kingdom.</p>
      </div>

      <div class="footer-section">
        <h4>Explore</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/mountains/">Mountains</a></li>
          <li><a href="/nature-reserves/">Nature Reserves</a></li>
          <li><a href="/woodland-walks/">Woodland Walks</a></li>
          <li><a href="/yorkshire-dales-walks/">Yorkshire Dales Walks</a></li>
          <li><a href="/outdoor-activities/">Outdoor Activities</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Information</h4>
        <ul class="footer-links">
          <li><a href="/all-mountains/">All Mountains A–Z</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Legal</h4>
        <ul class="footer-links">
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-of-service/">Terms of Service</a></li>
          <li><a href="/cookie-policy/">Cookie Policy</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Resources</h4>
        <ul class="footer-links">
          <li><a href="https://www.metoffice.gov.uk/weather/warnings-and-advice/uk-storm-centre" target="_blank" rel="noopener">Weather Warnings</a></li>
          <li><a href="https://www.mountain.rescue.org.uk" target="_blank" rel="noopener">Mountain Rescue</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} UK Mountains Directory. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-neutral-900);
    color: var(--color-neutral-300);
    padding: var(--spacing-3xl) 0 var(--spacing-lg);
    margin-top: var(--spacing-3xl);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
  }

  .footer-section h4 {
    color: white;
    font-size: 1.125rem;
    margin-bottom: var(--spacing-md);
  }

  .footer-section p {
    line-height: 1.5;
    margin-bottom: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: var(--spacing-sm);
  }

  .footer-links a {
    color: var(--color-neutral-300);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:focus {
    outline: 2px solid var(--color-primary-light);
    outline-offset: 2px;
  }

  .footer-links a:hover {
    color: var(--color-primary-light);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-neutral-700);
    padding-top: var(--spacing-lg);
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .footer {
      padding: var(--spacing-xl) 0 var(--spacing-md);
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>
