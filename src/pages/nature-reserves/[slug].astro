---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import CrossSectionLinks from '../../components/CrossSectionLinks.astro';
import { getNatureReserveBySlug, getRelatedNatureReserves, getAllNatureReserves, type NatureReserve } from '../../lib/entity-data';

export async function getStaticPaths() {
  const reserves = getAllNatureReserves();
  return reserves.map((reserve) => ({
    params: { slug: reserve.slug },
  }));
}

const { slug } = Astro.params;
const reserve = getNatureReserveBySlug(slug!);

if (!reserve) {
  return Astro.redirect('/404');
}

const related = getRelatedNatureReserves(reserve.slug, 4);

const pageTitle = reserve.seo_title || `${reserve.name}: Guide to the Nature Reserve`;
const pageDescription = reserve.seo_description || `Explore ${reserve.name} in ${reserve.region}. Find access details, wildlife, habitat info and visitor tips.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ukmountainsdirectory.co.uk/" },
    { "@type": "ListItem", "position": 2, "name": "Nature Reserves", "item": "https://ukmountainsdirectory.co.uk/nature-reserves/" },
    { "@type": "ListItem", "position": 3, "name": reserve.name, "item": `https://ukmountainsdirectory.co.uk/nature-reserves/${reserve.slug}/` }
  ]
};

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": reserve.name,
  "description": reserve.description,
  "address": { "@type": "PostalAddress", "addressRegion": reserve.region, "addressCountry": "GB" },
  "url": `https://ukmountainsdirectory.co.uk/nature-reserves/${reserve.slug}/`
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "author": { "@type": "Person", "name": "James Holloway", "url": "https://ukmountainsdirectory.co.uk/about/" },
  "publisher": { "@type": "Organization", "name": "UK Mountains Directory", "url": "https://ukmountainsdirectory.co.uk" },
  "datePublished": "2026-08-18",
  "dateModified": "2026-08-18",
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://ukmountainsdirectory.co.uk/nature-reserves/${reserve.slug}/` }
};

const faqSchemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": reserve.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};

const weatherUrl = 'https://www.metoffice.gov.uk/';
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(touristAttractionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaData)} />

  <div class="hero-section">
    <div class="hero-image">
      <img src="https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=1200" alt={`${reserve.name} - ${reserve.region}`} onerror="this.onerror=null;this.src='https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=1200'" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content page-wrap">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: 'Nature Reserves', url: '/nature-reserves/' },
        { name: reserve.name }
      ]} />
      <h1>{reserve.seo_h1 || reserve.name}</h1>
      <div class="hero-subtitle">{reserve.region}, {reserve.nation}</div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-num">{reserve.size_hectares}</span>
          <span class="stat-lbl">Size (ha)</span>
        </div>
        <div class="hero-stat">
          <span class="stat-num">{reserve.habitat_type}</span>
          <span class="stat-lbl">Habitat</span>
        </div>
        <div class="hero-stat">
          <span class={`difficulty-badge difficulty-${reserve.access_difficulty.toLowerCase()}`}>{reserve.access_difficulty}</span>
          <span class="stat-lbl">Access</span>
        </div>
        <div class="hero-stat">
          <span class="stat-num">NNR</span>
          <span class="stat-lbl">Status</span>
        </div>
      </div>
      <div class="hero-actions">
        <a href="#about" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg>
          View Trails
        </a>
        <a href={weatherUrl} target="_blank" rel="noopener" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
          Check Weather
        </a>
        <button id="visited-btn" class="btn btn-climbed" data-slug={reserve.slug} aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span id="visited-label">I've Visited This</span>
        </button>
      </div>
    </div>
  </div>

  <div class="page-wrap">
    <div class="page-body">
      <aside class="sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">Quick Facts</h3>
          <dl class="fact-list">
            <dt>Location</dt><dd>{reserve.region}, {reserve.nation}</dd>
            <dt>Nearest Town</dt><dd>{reserve.nearest_town}</dd>
            <dt>OS Grid Ref</dt><dd class="mono">{reserve.os_grid_ref}</dd>
            <dt>Managing Body</dt><dd>{reserve.managing_body}</dd>
            <dt>Habitat Type</dt><dd>{reserve.habitat_type}</dd>
            <dt>Size</dt><dd>{reserve.size_hectares}</dd>
            <dt>Access</dt><dd>{reserve.access_difficulty}</dd>
          </dl>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-title">Classification</h3>
          <div class="tag-group">
            <span class="cls-tag">National Nature Reserve</span>
          </div>
        </div>

        <div class="sidebar-card sidebar-weather">
          <h3 class="sidebar-title">Weather</h3>
          <p class="season-pill">Best: {reserve.best_season}</p>
          <a href={weatherUrl} target="_blank" rel="noopener" class="weather-link">Met Office Forecast</a>
          <div class="weather-note">Check conditions before visiting — reserve paths can be wet and muddy year-round.</div>
        </div>

        {reserve.nearby_places && reserve.nearby_places.length > 0 && (
          <div class="sidebar-card">
            <h3 class="sidebar-title">Nearby Places</h3>
            <ul class="nearby-list">
              {reserve.nearby_places.map((place: string) => <li>{place}</li>)}
            </ul>
          </div>
        )}

        <div class="sidebar-card">
          <h3 class="sidebar-title">Facilities</h3>
          <p class="facilities-text">{reserve.facilities}</p>
        </div>

        <div class="sidebar-card sidebar-gear">
          <h3 class="sidebar-title">Recommended Gear</h3>
          <ul class="gear-list">
            <li><a href="https://www.amazon.co.uk/s?k=binoculars+nature+watching" target="_blank" rel="noopener sponsored" class="gear-link">Binoculars</a></li>
            <li><a href="https://www.amazon.co.uk/s?k=wellies+walking" target="_blank" rel="noopener sponsored" class="gear-link">Wellington Boots</a></li>
            <li><a href="https://www.amazon.co.uk/s?k=field+guide+british+wildlife" target="_blank" rel="noopener sponsored" class="gear-link">Field Guide</a></li>
            <li><a href="https://www.amazon.co.uk/s?k=insect+repellent+uk" target="_blank" rel="noopener sponsored" class="gear-link">Insect Repellent</a></li>
          </ul>
          <p class="gear-disclaimer">* Affiliate links — we may earn a small commission at no extra cost to you.</p>
        </div>
      </aside>

      <main class="main-content">
        <AuthorByline lastUpdated="August 2026" />

        <section id="about" class="content-section">
          <h2>About {reserve.name}</h2>
          <p class="lead">{reserve.description}</p>
          <details class="expand-block">
            <summary>History &amp; Background</summary>
            <p>{reserve.history}</p>
          </details>
        </section>

        <section class="content-section">
          <h2>Wildlife &amp; Habitat at {reserve.name}</h2>
          <p>{reserve.wildlife}</p>
        </section>

        <section class="content-section">
          <h2>Location &amp; Nearest Towns</h2>
          <p>
            {reserve.name} is located in <strong>{reserve.region}</strong>, {reserve.nation}. The nearest town is {reserve.nearest_town}.
            {reserve.nearby_places && reserve.nearby_places.length > 0 ? ` Nearby places include ${reserve.nearby_places.join(', ')}.` : ''}
          </p>
        </section>

        <section class="content-section gallery-section">
          <div class="gallery-row">
            <div class="gallery-item">
              <img src="https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=1200" alt={`${reserve.name} - view 1`} loading="lazy" />
            </div>
            <div class="gallery-item">
              <img src="https://images.pexels.com/photos/2662116/pexels-photo-2662116.jpeg?auto=compress&cs=tinysrgb&w=1200" alt={`${reserve.name} - view 2`} loading="lazy" />
            </div>
          </div>
        </section>

        {reserve.fun_facts && reserve.fun_facts.length > 0 && (
          <section class="content-section">
            <h2>Interesting Facts</h2>
            <ul class="facts-list">
              {reserve.fun_facts.map((fact: string) => <li>{fact}</li>)}
            </ul>
          </section>
        )}

        <section class="content-section">
          <h2>Visitor Tips for {reserve.name}</h2>
          <div class="safety-grid">
            <div class="safety-card">
              <strong>Best Time to Visit</strong>
              <p>{reserve.best_season} offers the best conditions for wildlife viewing.</p>
            </div>
            <div class="safety-card">
              <strong>What to Bring</strong>
              <p>Binoculars, walking boots or wellies, waterproofs, and a field guide. Insect repellent in summer.</p>
            </div>
            <div class="safety-card">
              <strong>Access &amp; Parking</strong>
              <p>{reserve.facilities}</p>
            </div>
            <div class="safety-card">
              <strong>Facilities</strong>
              <p>{reserve.facilities}</p>
            </div>
          </div>
        </section>

        <section class="content-section">
          <h2>Exploring {reserve.name}</h2>
          <p>
            {reserve.name} is a {reserve.access_difficulty.toLowerCase()}-access reserve in {reserve.region}. The habitat is primarily {reserve.habitat_type}, and the reserve is managed by {reserve.managing_body}. Whether you're a seasoned naturalist or a first-time visitor, the reserve offers a peaceful escape into some of the UK's finest protected landscape.
          </p>
        </section>

        <section class="content-section">
          <h2>Frequently Asked Questions</h2>
          <div class="faqs">
            {reserve.faqs.map((faq: { question: string; answer: string }) => (
              <details class="faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="content-section seo-section">
          <h2>Why Visit {reserve.name}?</h2>
          <p>
            {reserve.name} is a designated <strong>National Nature Reserve</strong> in {reserve.region}, {reserve.nation} — one of the UK's finest protected wildlife sites. Browse our <a href="/nature-reserves/" class="inline-link">full directory of UK nature reserves</a> to discover more sites to visit.
          </p>
        </section>

        {related.length > 0 && (
          <section class="nearby-peaks">
            <h2>Nearby Nature Reserves to Explore</h2>
            <p class="np-intro">Looking beyond {reserve.name}? These reserves are worth exploring.</p>
            <div class="np-grid">
              {related.map((r: NatureReserve) => (
                <a href={`/nature-reserves/${r.slug}/`} class="np-card">
                  <div class="np-image">
                    <div class="np-image-placeholder">
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/></svg>
                    </div>
                  </div>
                  <div class="np-info">
                    <h3>{r.name}</h3>
                    <div class="np-meta">
                      <span class="np-region">{r.region}</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <CrossSectionLinks />
      </main>
    </div>
  </div>
</Layout>

<script>
  const btn = document.getElementById('visited-btn') as HTMLButtonElement | null;
  if (btn) {
    const slug = btn.dataset.slug || '';
    const key = `visited-${slug}`;
    const label = document.getElementById('visited-label');
    function setVisited(visited: boolean) {
      if (visited) {
        btn!.classList.add('climbed');
        btn!.setAttribute('aria-pressed', 'true');
        if (label) label.textContent = 'Visited!';
        localStorage.setItem(key, '1');
      } else {
        btn!.classList.remove('climbed');
        btn!.setAttribute('aria-pressed', 'false');
        if (label) label.textContent = "I've Visited This";
        localStorage.removeItem(key);
      }
    }
    setVisited(localStorage.getItem(key) === '1');
    btn.addEventListener('click', () => { setVisited(localStorage.getItem(key) !== '1'); });
  }
</script>

<style>
  .key-takeaways { max-width: 900px; margin: 0 0 var(--spacing-2xl) 0; background: var(--color-neutral-50); border-left: 4px solid var(--color-primary); border-radius: var(--radius-md); padding: var(--spacing-xl); }
  .page-wrap { max-width: 1140px; margin: 0 auto; padding: 0 var(--spacing-lg); }
  .page-body { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: var(--spacing-2xl); align-items: start; padding: var(--spacing-2xl) 0 var(--spacing-3xl); }
  .hero-section { position: relative; height: 480px; display: flex; align-items: flex-end; color: white; }
  .hero-image { position: absolute; inset: 0; z-index: 0; }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.2) 60%, transparent 100%); }
  .hero-content { position: relative; z-index: 1; padding-bottom: var(--spacing-2xl); width: 100%; }
  .hero-content h1 { font-size: 2.75rem; margin: 0 0 var(--spacing-sm) 0; color: white !important; text-shadow: 0 2px 12px rgba(0,0,0,0.7); line-height: 1.15; }
  .hero-subtitle { font-size: 1.1rem; opacity: 0.9; margin-bottom: var(--spacing-md); }
  .hero-stats { display: flex; gap: var(--spacing-xl); margin-bottom: var(--spacing-lg); flex-wrap: wrap; }
  .hero-stat { display: flex; flex-direction: column; }
  .stat-num { font-size: 1.5rem; font-weight: 700; line-height: 1; }
  .stat-lbl { font-size: 0.8rem; opacity: 0.85; margin-top: 2px; }
  .hero-actions { display: flex; gap: var(--spacing-md); flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: var(--radius-md); text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: all var(--transition-base); }
  .btn-primary { background: var(--color-primary); color: white; }
  .btn-primary:hover { background: #0a5c3d; transform: translateY(-2px); }
  .btn-secondary { background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(8px); }
  .btn-secondary:hover { background: rgba(255,255,255,0.25); transform: translateY(-2px); }
  .btn-climbed { background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(8px); cursor: pointer; }
  .btn-climbed:hover { background: rgba(255,255,255,0.25); transform: translateY(-2px); }
  .btn-climbed.climbed { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }
  .difficulty-badge { padding: 4px 12px; border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .difficulty-easy { background: #d1fae5; color: #065f46; }
  .difficulty-moderate { background: #fed7aa; color: #9a3412; }
  .difficulty-hard { background: #fecaca; color: #991b1b; }
  .sidebar { display: flex; flex-direction: column; gap: var(--spacing-lg); position: sticky; top: 24px; order: 2; min-width: 0; overflow: hidden; }
  .sidebar-card { background: white; border-radius: var(--radius-lg); padding: var(--spacing-lg); box-shadow: var(--shadow-md); border: 1px solid var(--color-neutral-200); }
  .sidebar-title { display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 700; color: var(--color-neutral-900); margin: 0 0 var(--spacing-md) 0; text-transform: uppercase; letter-spacing: 0.5px; }
  .fact-list { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; font-size: 0.875rem; }
  .fact-list dt { font-weight: 600; color: var(--color-neutral-600); white-space: nowrap; }
  .fact-list dd { margin: 0; color: var(--color-neutral-900); word-break: break-word; }
  .mono { font-family: var(--font-mono, monospace); font-size: 0.8rem; background: var(--color-neutral-100); padding: 1px 5px; border-radius: 3px; }
  .tag-group { display: flex; flex-wrap: wrap; gap: 6px; }
  .cls-tag { padding: 4px 10px; background: rgba(15,118,110,0.1); color: var(--color-primary); border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 600; border: 1px solid rgba(15,118,110,0.2); }
  .sidebar-weather .season-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; background: #f0fdf4; color: #166534; padding: 4px 10px; border-radius: var(--radius-full); margin-bottom: var(--spacing-md); font-weight: 600; }
  .weather-link { display: flex; align-items: center; gap: 8px; padding: 9px 14px; background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); text-decoration: none; font-size: 0.875rem; font-weight: 600; color: var(--color-neutral-800); transition: all var(--transition-fast); margin-bottom: var(--spacing-sm); }
  .weather-link:hover { background: var(--color-primary); border-color: var(--color-primary); color: white; }
  .weather-note { font-size: 0.78rem; color: var(--color-neutral-500); line-height: 1.5; margin-top: var(--spacing-sm); padding-top: var(--spacing-sm); border-top: 1px solid var(--color-neutral-100); }
  .nearby-list { margin: 0; padding: 0 0 0 var(--spacing-md); list-style: disc; font-size: 0.875rem; color: var(--color-neutral-700); line-height: 1.7; }
  .facilities-text { font-size: 0.875rem; color: var(--color-neutral-700); margin: 0; line-height: 1.5; }
  .sidebar-gear .gear-list { list-style: none; padding: 0; margin: 0 0 var(--spacing-sm) 0; display: flex; flex-direction: column; gap: 4px; }
  .gear-link { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--color-neutral-800); text-decoration: none; padding: 6px 8px; border-radius: var(--radius-sm); transition: all var(--transition-fast); }
  .gear-link:hover { background: var(--color-neutral-100); color: var(--color-primary); }
  .gear-disclaimer { font-size: 0.7rem; color: var(--color-neutral-400); margin: 0; line-height: 1.4; }
  .main-content { display: flex; flex-direction: column; gap: 0; order: 1; min-width: 0; }
  .content-section { background: white; border-radius: var(--radius-lg); padding: var(--spacing-xl); box-shadow: var(--shadow-sm); border: 1px solid var(--color-neutral-200); margin-bottom: var(--spacing-lg); }
  .content-section h2 { font-size: 1.5rem; color: var(--color-neutral-900); margin: 0 0 var(--spacing-md) 0; padding-bottom: var(--spacing-sm); border-bottom: 2px solid var(--color-neutral-100); }
  .lead { font-size: 1.05rem; line-height: 1.7; color: var(--color-neutral-700); margin: 0 0 var(--spacing-md) 0; }
  .expand-block { border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); overflow: hidden; }
  .expand-block summary { padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; cursor: pointer; color: var(--color-primary); background: var(--color-neutral-50); list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none; font-size: 0.95rem; }
  .expand-block summary::-webkit-details-marker { display: none; }
  .expand-block summary::after { content: '+'; font-size: 1.25rem; color: var(--color-primary); }
  .expand-block[open] summary::after { content: '−'; }
  .expand-block p { padding: var(--spacing-lg); margin: 0; font-size: 0.95rem; line-height: 1.7; color: var(--color-neutral-700); border-top: 1px solid var(--color-neutral-100); }
  .gallery-section { padding: 0; border: none; background: transparent; box-shadow: none; }
  .gallery-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-sm); }
  .gallery-item { border-radius: var(--radius-md); overflow: hidden; height: 200px; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); display: block; }
  .gallery-item:hover img { transform: scale(1.05); }
  .facts-list { list-style: none; counter-reset: facts; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--spacing-sm); }
  .facts-list li { counter-increment: facts; display: flex; align-items: flex-start; gap: var(--spacing-md); padding: var(--spacing-md); background: var(--color-neutral-50); border-radius: var(--radius-md); font-size: 0.95rem; line-height: 1.6; color: var(--color-neutral-700); }
  .facts-list li::before { content: counter(facts); min-width: 28px; height: 28px; background: var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; }
  .safety-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
  .safety-card { display: flex; gap: var(--spacing-md); align-items: flex-start; padding: var(--spacing-md); background: var(--color-neutral-50); border-radius: var(--radius-md); border-left: 3px solid #f59e0b; font-size: 0.875rem; }
  .safety-card strong { display: block; margin-bottom: 4px; color: var(--color-neutral-900); font-size: 0.9rem; }
