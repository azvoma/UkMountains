---
import Layout from '../layouts/Layout.astro';

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Us – UK Mountains Directory",
  "description": "Get in touch with UK Mountains Directory for questions about UK mountains, hiking tips, route planning, and more."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you help me plan a route for the top 10 highest mountains in UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we can guide you on suitable routes, difficulty levels, and preparation tips for climbing the highest peaks in the UK."
      }
    },
    {
      "@type": "Question",
      "name": "Do you recommend any easy mountains to climb UK for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we can recommend beginner-friendly mountains that are safe, scenic, and perfect for families or new hikers."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to receive a reply?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We aim to respond to all email enquiries within 2 business days."
      }
    },
    {
      "@type": "Question",
      "name": "Can I submit corrections or new mountain data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you spot errors or want to contribute new information, simply email us directly."
      }
    }
  ]
};
---

<Layout
  title="Contact Us – UK Mountains Directory"
  description="Get in touch with UK Mountains Directory. Email us for questions about UK mountains, hiking routes, data corrections, or partnership enquiries."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="contact-page">

    <section class="contact-hero">
      <div class="container">
        <h1>Contact UK Mountains Directory</h1>
        <p class="hero-lead">
          Have a question about UK mountains, want to suggest a correction, or interested in contributing to the directory? We'd love to hear from you.
        </p>
      </div>
    </section>

    <div class="container">

      <section class="contact-main">
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-10 7L2 7"/>
            </svg>
          </div>
          <div class="contact-card-body">
            <h2>Get in Touch</h2>
            <p>The best way to reach us is by email. We respond to all enquiries within 2 business days.</p>
            <a href="mailto:azvoma@gmail.com" class="email-link">azvoma@gmail.com</a>
          </div>
        </div>

        <div class="contact-details-row">
          <div class="detail-item">
            <div class="detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <strong>Response Time</strong>
              <span>Within 2 business days</span>
            </div>
          </div>
          <div class="detail-item">
            <div class="detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <strong>Based In</strong>
              <span>United Kingdom</span>
            </div>
          </div>
        </div>
      </section>

      <section class="help-section">
        <h2>How We Can Help</h2>
        <p>You can contact us for:</p>
        <div class="help-grid">
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            <span>Info about the <strong>top 10 highest mountains in the UK</strong></span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Route suggestions for beginners and families</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="22" x2="12" y2="5"/>
              <polyline points="8 9 12 5 16 9"/>
            </svg>
            <span>Advice on <strong>easy mountains to climb UK</strong></span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            <span>Corrections or updates to our mountain database</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>Partnership or collaboration enquiries</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-10 7L2 7"/>
            </svg>
            <span>Listing or featuring your hiking group or service</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 19l7-7 3 3-7 7-3-3z"/>
              <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
            </svg>
            <span>Media and press information</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span>General mountain advice and safety tips</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>Access and parking information for specific peaks</span>
          </div>
        </div>
      </section>

      <section class="why-contact-section">
        <h2>Why Hikers Contact Us</h2>
        <p>We regularly receive messages about:</p>
        <div class="why-contact-grid">
          <div class="why-contact-card">
            <h3>Top 10 Highest Mountains</h3>
            <p>The best ways to climb the top 10 highest mountains in the UK, including preparation tips and difficulty levels.</p>
          </div>
          <div class="why-contact-card">
            <h3>Beginner Routes</h3>
            <p>Safer beginner routes on famous peaks and easy mountains to climb UK for first-time hikers.</p>
          </div>
          <div class="why-contact-card">
            <h3>Family Hiking</h3>
            <p>Tips for kids and family hiking trips with distance, duration, and terrain advice.</p>
          </div>
          <div class="why-contact-card">
            <h3>Weather & Seasonal Guidance</h3>
            <p>Best times to climb, seasonal conditions, and weather preparation for UK mountains.</p>
          </div>
          <div class="why-contact-card">
            <h3>Maps & Navigation</h3>
            <p>Navigation support, GPS coordinates, parking postcodes, and OS grid references.</p>
          </div>
          <div class="why-contact-card">
            <h3>Mountain Classifications</h3>
            <p>Questions about Munros, Corbetts, Hewitts, Wainwrights, and other mountain classifications.</p>
          </div>
        </div>
        <p class="help-footer">If it's about mountains — we can help.</p>
      </section>

      <section class="contribute-section">
        <h2>Want to Contribute to Our Directory?</h2>
        <p>We welcome contributions from:</p>
        <div class="contribute-grid">
          <div class="contribute-tag">Local Guides</div>
          <div class="contribute-tag">Hikers</div>
          <div class="contribute-tag">Photographers</div>
          <div class="contribute-tag">Drone Enthusiasts</div>
          <div class="contribute-tag">Mountain Writers</div>
          <div class="contribute-tag">Outdoor Organisations</div>
        </div>
        <p>
          If you want to submit new mountain info, photos, routes, or corrections, email us anytime. We value community contributions and aim to make this the most comprehensive UK mountains resource available.
        </p>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-container">
          <details class="faq-item">
            <summary>Can you help me plan a route for the top 10 highest mountains in UK?</summary>
            <p>
              Yes, we can guide you on suitable routes, difficulty levels, and preparation tips for climbing the highest UK peaks. Email us with details about your experience level, fitness, and timeline, and we'll provide tailored recommendations.
            </p>
          </details>

          <details class="faq-item">
            <summary>Do you recommend any easy mountains to climb UK for beginners?</summary>
            <p>
              Absolutely! We can suggest scenic, beginner-friendly mountains perfect for families and new hikers. Our directory includes detailed information about difficulty levels, time estimates, and facilities to help you choose the right mountain for your first climb.
            </p>
          </details>

          <details class="faq-item">
            <summary>How long does it take to receive a reply?</summary>
            <p>
              We respond to all email enquiries within 2 business days. Complex enquiries or data verification may take slightly longer, but we'll acknowledge your message and keep you updated on progress.
            </p>
          </details>

          <details class="faq-item">
            <summary>Can I submit corrections or new mountain data?</summary>
            <p>
              Yes! If you spot errors or want to contribute new information, simply email us directly. Include the mountain name and specific corrections needed. Providing OS grid references or other verification sources helps us update information more quickly.
            </p>
          </details>

          <details class="faq-item">
            <summary>Can I submit my own mountain photos?</summary>
            <p>
              Yes! We welcome high-quality photos from the mountain community. Email us with the mountain name, date taken, and any relevant information. Photos should be your own work, and by submitting them, you grant us permission to use them on our website with credit to you.
            </p>
          </details>

          <details class="faq-item">
            <summary>Do you offer guided mountain walks or tours?</summary>
            <p>
              No, UK Mountains Directory is an information resource only. We don't organise or lead mountain walks, tours, or guided expeditions. However, we can point you towards reputable guide services and mountaineering clubs.
            </p>
          </details>

          <details class="faq-item">
            <summary>How can I support UK Mountains Directory?</summary>
            <p>
              The best way to support us is by using and sharing our directory with fellow mountain enthusiasts. Provide feedback, report errors, contribute photos, and help spread the word. If you represent an organisation interested in sponsorship or partnership opportunities, please get in touch.
            </p>
          </details>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .contact-page {
    background: var(--color-neutral-50);
    min-height: calc(100vh - 400px);
  }

  .contact-hero {
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
    padding: var(--spacing-3xl) 0;
    text-align: center;
  }

  .contact-hero h1 {
    color: white;
    font-size: 2.75rem;
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero-lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.2rem;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .contact-main {
    padding: var(--spacing-3xl) 0 var(--spacing-2xl);
  }

  .contact-card {
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--spacing-2xl);
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-xl);
    max-width: 700px;
    margin: 0 auto var(--spacing-xl);
    border-left: 4px solid var(--color-primary);
  }

  .contact-card-icon {
    width: 56px;
    height: 56px;
    background: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: white;
  }

  .contact-card-body h2 {
    font-size: 1.5rem;
    color: var(--color-neutral-900);
    margin-bottom: var(--spacing-sm);
  }

  .contact-card-body p {
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  .email-link {
    display: inline-block;
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .email-link:hover {
    border-bottom-color: var(--color-primary);
  }

  .contact-details-row {
    display: flex;
    gap: var(--spacing-xl);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-xl);
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    background: white;
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    min-width: 240px;
  }

  .detail-icon {
    width: 40px;
    height: 40px;
    background: rgba(15, 118, 110, 0.1);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .detail-item div:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .detail-item strong {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-neutral-500);
    font-weight: 600;
  }

  .detail-item span {
    font-size: 1rem;
    color: var(--color-neutral-800);
    font-weight: 500;
  }

  .help-section {
    margin-bottom: var(--spacing-3xl);
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .help-section h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
    text-align: center;
    color: var(--color-neutral-900);
  }

  .help-section > p {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin-bottom: var(--spacing-lg);
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-md);
  }

  .help-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    background: var(--color-neutral-50);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary);
    transition: all var(--transition-base);
  }

  .help-item:hover {
    background: var(--color-neutral-100);
    transform: translateX(4px);
  }

  .help-item svg {
    flex-shrink: 0;
    color: var(--color-primary);
    margin-top: 2px;
  }

  .help-item span {
    line-height: 1.5;
    color: var(--color-neutral-700);
  }

  .why-contact-section {
    margin-bottom: var(--spacing-3xl);
    padding: var(--spacing-2xl);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .why-contact-section h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
    text-align: center;
    color: var(--color-neutral-900);
  }

  .why-contact-section > p {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin-bottom: var(--spacing-xl);
  }

  .why-contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  .why-contact-card {
    padding: var(--spacing-lg);
    background: var(--color-neutral-50);
    border-radius: var(--radius-md);
    border: 2px solid var(--color-neutral-200);
    transition: all var(--transition-base);
  }

  .why-contact-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .why-contact-card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-neutral-900);
  }

  .why-contact-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-neutral-600);
    margin: 0;
  }

  .help-footer {
    text-align: center;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: var(--spacing-lg);
  }

  .contribute-section {
    margin-bottom: var(--spacing-3xl);
    padding: var(--spacing-2xl);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .contribute-section h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
    text-align: center;
    color: var(--color-neutral-900);
  }

  .contribute-section > p {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin-bottom: var(--spacing-lg);
  }

  .contribute-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    margin-bottom: var(--spacing-lg);
  }

  .contribute-tag {
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .faq-section {
    padding: var(--spacing-3xl) 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-section h2 {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-neutral-900);
  }

  .faq-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .faq-item {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .faq-item:hover {
    box-shadow: var(--shadow-md);
  }

  .faq-item summary {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-neutral-900);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    color: var(--color-primary);
    transition: transform var(--transition-base);
    flex-shrink: 0;
    margin-left: var(--spacing-md);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin-top: var(--spacing-md);
    line-height: 1.6;
    color: var(--color-neutral-700);
  }

  @media (max-width: 768px) {
    .contact-hero h1 {
      font-size: 1.9rem;
    }

    .hero-lead {
      font-size: 1rem;
    }

    .contact-card {
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .contact-details-row {
      flex-direction: column;
      align-items: stretch;
    }

    .detail-item {
      min-width: unset;
    }

    .help-grid,
    .why-contact-grid {
      grid-template-columns: 1fr;
    }

    .help-section,
    .why-contact-section,
    .contribute-section {
      padding: var(--spacing-lg);
    }

    .help-section h2,
    .why-contact-section h2,
    .contribute-section h2 {
      font-size: 1.5rem;
    }
  }
</style>
