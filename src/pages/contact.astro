---
import Layout from '../layouts/Layout.astro';

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Us – Top 10 Highest Mountains in UK",
  "description": "Contact our team for information about the top 10 highest mountains in UK, including beginner routes and easy mountains to climb UK."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you help me plan a route for the top 10 highest mountains in UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we can guide you on suitable routes, difficulty levels, and preparation tips for climbing the highest peaks in the UK."
      }
    },
    {
      "@type": "Question",
      "name": "Do you recommend any easy mountains to climb UK for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we can recommend beginner-friendly mountains that are safe, scenic, and perfect for families or new hikers."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to receive a reply?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We respond to all contact form messages within 24–48 hours."
      }
    },
    {
      "@type": "Question",
      "name": "Can I submit corrections or new mountain data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you spot errors or want to contribute new information, simply contact us using the form above."
      }
    }
  ]
};
---

<Layout
  title="Top 10 Highest Mountains in UK – Contact Our Team"
  description="Contact us for questions about the top 10 highest mountains in UK, hiking tips, and guides to easy mountains to climb in the UK. We're here to help."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="contact-page">
    <div class="container">
      <div class="contact-header">
        <h1>Contact Us About the Top 10 Highest Mountains in UK</h1>
        <p class="lead-intro">
          If you have questions about the top 10 highest mountains in UK, need help planning your next hiking trip, or want guidance on easy mountains to climb UK, our team is here to support you. Whether you're a beginner, an experienced climber, or a directory contributor, we'd love to hear from you.
        </p>
        <p class="mission-text">Our mission is to make exploring UK mountains easier, safer, and more enjoyable for everyone.</p>
      </div>

      <div class="contact-grid">
        <div class="contact-form-section">
          <form id="contact-form" class="contact-form">
            <div class="form-group">
              <label for="name">Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
              />
            </div>

            <div class="form-group">
              <label for="email">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="your.email@example.com"
              />
            </div>

            <div class="form-group">
              <label for="subject">Reason for Contact *</label>
              <select id="subject" name="subject" required>
                <option value="">Select a reason</option>
                <option value="top-10-mountains">Top 10 Highest Mountains Info</option>
                <option value="beginner-routes">Easy Mountains to Climb UK</option>
                <option value="route-advice">Route Planning & Advice</option>
                <option value="correction">Data Correction</option>
                <option value="contribution">Submit Photos/Information</option>
                <option value="partnership">Partnership Inquiry</option>
                <option value="general">General Inquiry</option>
                <option value="technical">Technical Issue</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="mountain">Optional: Mountain or Route You're Enquiring About</label>
              <input
                type="text"
                id="mountain"
                name="mountain"
                placeholder="e.g., Ben Nevis, Snowdon, Scafell Pike"
              />
            </div>

            <div class="form-group">
              <label for="message">Message *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                placeholder="Tell us how we can help..."
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary submit-btn">
              <span class="btn-text">Send Message</span>
              <span class="btn-loading" style="display: none;">Sending...</span>
            </button>

            <div id="form-message" class="form-message" style="display: none;"></div>
          </form>
        </div>

        <div class="contact-info">
          <div class="info-card">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <h3>Email Us</h3>
            <p>For general inquiries:</p>
            <a href="mailto:info@ukmountains.directory">info@ukmountains.directory</a>
            <p style="margin-top: 1rem;">For data corrections:</p>
            <a href="mailto:corrections@ukmountains.directory">corrections@ukmountains.directory</a>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3>Response Time</h3>
            <p>
              We aim to respond to all inquiries within 24-48 hours during business days.
              Thank you for your patience.
            </p>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <h3>Get Involved</h3>
            <p>
              We welcome contributions from mountain enthusiasts. If you have photos,
              corrections, or additional information about UK mountains, please reach out.
            </p>
          </div>

          <div class="info-card help-card">
            <h3>Quick Tips</h3>
            <ul>
              <li>Response time: 24-48 hours</li>
              <li>Include mountain names for data corrections</li>
              <li>Photos welcome in common formats (JPG, PNG)</li>
              <li>Check FAQ section below before contacting</li>
            </ul>
          </div>
        </div>
      </div>

      <section class="help-section">
        <h2>How We Can Help</h2>
        <p>You can contact us for:</p>
        <div class="help-grid">
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            <span>Info about the <strong>top 10 highest mountains in the UK</strong></span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Route suggestions for beginners and families</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            <span>Advice on <strong>easy mountains to climb UK</strong></span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>Corrections or updates to our mountain database</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>Partnership or collaboration enquiries</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Listing or featuring your hiking group or service</span>
          </div>
          <div class="help-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
              <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
            </svg>
            <span>Media and press information</span>
          </div>
        </div>
      </section>

      <section class="why-contact-section">
        <h2>Why Hikers Contact Us</h2>
        <p>We regularly receive messages about:</p>
        <div class="why-contact-grid">
          <div class="why-contact-card">
            <h3>Top 10 Highest Mountains</h3>
            <p>The best ways to climb the top 10 highest mountains in the UK, including preparation tips and difficulty levels.</p>
          </div>
          <div class="why-contact-card">
            <h3>Beginner Routes</h3>
            <p>Safer beginner routes on famous peaks and easy mountains to climb UK for first-time hikers.</p>
          </div>
          <div class="why-contact-card">
            <h3>Family Hiking</h3>
            <p>Tips for kids & family hiking trips with distance, duration, and terrain advice.</p>
          </div>
          <div class="why-contact-card">
            <h3>Weather & Seasonal Guidance</h3>
            <p>Best times to climb, seasonal conditions, and weather preparation for UK mountains.</p>
          </div>
          <div class="why-contact-card">
            <h3>Maps & Navigation</h3>
            <p>Navigation support, GPS coordinates, parking postcodes, and OS grid references.</p>
          </div>
          <div class="why-contact-card">
            <h3>Mountain Classifications</h3>
            <p>Questions about Munros, Corbetts, Hewitts, Wainwrights, and other mountain classifications.</p>
          </div>
        </div>
        <p class="help-footer">If it's about mountains—we can help.</p>
      </section>

      <section class="contribute-section">
        <h2>Want to Contribute to Our Directory?</h2>
        <p>We welcome contributions from:</p>
        <div class="contribute-grid">
          <div class="contribute-tag">Local Guides</div>
          <div class="contribute-tag">Hikers</div>
          <div class="contribute-tag">Photographers</div>
          <div class="contribute-tag">Drone Enthusiasts</div>
          <div class="contribute-tag">Mountain Writers</div>
          <div class="contribute-tag">Outdoor Organisations</div>
        </div>
        <p>
          If you want to submit new mountain info, photos, routes, or corrections, contact us anytime. We value community contributions and aim to make this the most comprehensive UK mountains resource available.
        </p>
      </section>

      <div class="container">
        <section class="faq-section">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-container">
            <details class="faq-item">
              <summary>Can you help me plan a route for the top 10 highest mountains in UK?</summary>
              <p>
                Yes, we can guide you on suitable routes, difficulty levels, and preparation tips for climbing the highest UK peaks. Contact us with details about your experience level, fitness, and timeline, and we'll provide tailored recommendations.
              </p>
            </details>

            <details class="faq-item">
              <summary>Do you recommend any easy mountains to climb UK for beginners?</summary>
              <p>
                Absolutely! We can suggest scenic, beginner-friendly mountains perfect for families and new hikers. Our directory includes detailed information about difficulty levels, time estimates, and facilities to help you choose the right mountain for your first climb.
              </p>
            </details>

            <details class="faq-item">
              <summary>How long does it take to receive a reply?</summary>
              <p>
                We respond to all contact form messages within 24–48 hours during business days. Complex inquiries or data verification may take slightly longer, but we'll acknowledge your message and keep you updated on progress.
              </p>
            </details>

            <details class="faq-item">
              <summary>Can I submit corrections or new mountain data?</summary>
              <p>
                Yes! If you spot errors or want to contribute new information, simply contact us using the form above. Select "Data Correction" or "Submit Photos/Information" as your reason for contact, and include as much detail as possible including mountain name and specific corrections needed.
              </p>
            </details>

            <details class="faq-item">
              <summary>How do I report incorrect mountain information?</summary>
              <p>
                Use the contact form above and select "Data Correction" as the subject. Please include the mountain name,
                specific information that needs correcting, and the correct information if you know it. Providing OS grid
                references or other verification sources helps us update information more quickly.
              </p>
            </details>

            <details class="faq-item">
              <summary>Can I submit my own mountain photos?</summary>
              <p>
                Yes! We welcome high-quality photos from the mountain community. Please contact us with details about the
                photos including mountain name, date taken, and any relevant information. Photos should be your own work,
                and by submitting them, you grant us permission to use them on our website with credit to you.
              </p>
            </details>

            <details class="faq-item">
              <summary>How long does it take to get a response?</summary>
              <p>
                We aim to respond to all inquiries within 24-48 hours during business days (Monday-Friday). Complex technical
                issues or data verification may take longer. If your inquiry is urgent, please mention this in your message.
                We appreciate your patience as our small team works to maintain this comprehensive directory.
              </p>
            </details>

            <details class="faq-item">
              <summary>Do you offer guided mountain walks or tours?</summary>
              <p>
                No, UK Mountains Directory is an information resource only. We don't organize or lead mountain walks, tours,
                or guided expeditions. However, we can point you towards reputable guide services and mountaineering clubs.
                Always ensure any guide or organization you choose is properly qualified and insured.
              </p>
            </details>

            <details class="faq-item">
              <summary>Can I suggest new features for the website?</summary>
              <p>
                Absolutely! We value feedback from our users and are always looking to improve. Use the contact form and
                select "Suggestion" as the subject. Tell us what features you'd like to see, what would improve your
                experience, or any other ideas you have. While we can't implement every suggestion, we carefully consider
                all feedback.
              </p>
            </details>

            <details class="faq-item">
              <summary>Do you have an API for developers?</summary>
              <p>
                We're currently exploring the possibility of offering an API for developers who want to integrate mountain
                data into their applications. If you're interested in this, please contact us with details about your project
                and how you'd like to use the data. This helps us understand developer needs and prioritize API development.
              </p>
            </details>

            <details class="faq-item">
              <summary>How can I support UK Mountains Directory?</summary>
              <p>
                The best way to support us is by using and sharing our directory with fellow mountain enthusiasts. Provide
                feedback, report errors, contribute photos, and help spread the word about our resource. If you represent
                an organization interested in sponsorship or partnership opportunities, please contact us to discuss possibilities.
              </p>
            </details>

            <details class="faq-item">
              <summary>Can you provide information for commercial projects?</summary>
              <p>
                For commercial use of our data, photography, or other resources, please contact us with details about your
                project, intended use, and timeline. We'll review your request and discuss appropriate arrangements. Personal,
                non-commercial use of information found on our website for trip planning and research is always free.
              </p>
            </details>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = form?.querySelector('.submit-btn') as HTMLButtonElement;
  const btnText = submitBtn?.querySelector('.btn-text') as HTMLSpanElement;
  const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLSpanElement;
  const formMessage = document.getElementById('form-message') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) {
      submitBtn.disabled = true;
      btnText.style.display = 'none';
      btnLoading.style.display = 'inline';
    }

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    setTimeout(() => {
      if (submitBtn) {
        submitBtn.disabled = false;
        btnText.style.display = 'inline';
        btnLoading.style.display = 'none';
      }

      if (formMessage) {
        formMessage.style.display = 'block';
        formMessage.className = 'form-message success';
        formMessage.textContent = 'Thank you for your message! We will get back to you soon.';
        form.reset();

        setTimeout(() => {
          formMessage.style.display = 'none';
        }, 5000);
      }
    }, 1000);
  });
</script>

<style>
  .contact-page {
    padding: var(--spacing-3xl) 0;
    background: var(--color-neutral-50);
    min-height: calc(100vh - 400px);
  }

  .contact-header {
    text-align: center;
    margin-bottom: var(--spacing-3xl);
  }

  .contact-header h1 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-lg);
    color: var(--color-neutral-900);
    line-height: 1.2;
  }

  .contact-header .lead-intro {
    font-size: 1.125rem;
    color: var(--color-neutral-700);
    line-height: 1.7;
    max-width: 900px;
    margin: 0 auto var(--spacing-md) auto;
  }

  .contact-header .mission-text {
    font-size: 1rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-top: var(--spacing-md);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: var(--spacing-2xl);
  }

  .contact-form-section {
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
    color: var(--color-neutral-700);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 12px 16px;
    border: 2px solid var(--color-neutral-300);
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-family: inherit;
    transition: border-color var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-btn {
    width: 100%;
  }

  .form-message {
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    text-align: center;
    font-weight: 500;
  }

  .form-message.success {
    background: #d1fae5;
    color: #065f46;
    border: 2px solid #10b981;
  }

  .form-message.error {
    background: #fee2e2;
    color: #991b1b;
    border: 2px solid #ef4444;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .info-card {
    background: white;
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .info-icon {
    width: 48px;
    height: 48px;
    background: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-md);
  }

  .info-icon svg {
    color: white;
  }

  .info-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-neutral-900);
  }

  .info-card p {
    color: var(--color-neutral-600);
    margin-bottom: var(--spacing-sm);
    line-height: 1.5;
  }

  .info-card a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .info-card a:hover {
    text-decoration: underline;
  }

  .help-card {
    background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
  }

  .help-card ul {
    list-style: none;
    padding: 0;
    margin: var(--spacing-md) 0;
  }

  .help-card li {
    padding: var(--spacing-sm) 0;
    color: var(--color-neutral-700);
    position: relative;
    padding-left: var(--spacing-lg);
  }

  .help-card li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: bold;
  }

  .faq-section {
    padding: var(--spacing-3xl) 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-section h2 {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-neutral-900);
  }

  .faq-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .faq-item {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .faq-item:hover {
    box-shadow: var(--shadow-md);
  }

  .faq-item summary {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-neutral-900);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    color: var(--color-primary);
    transition: transform var(--transition-base);
    flex-shrink: 0;
    margin-left: var(--spacing-md);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin-top: var(--spacing-md);
    line-height: 1.6;
    color: var(--color-neutral-700);
  }

  /* HELP SECTION */
  .help-section {
    margin-bottom: var(--spacing-3xl);
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .help-section h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
    text-align: center;
    color: var(--color-neutral-900);
