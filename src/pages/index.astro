---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import MountainCard from '../components/MountainCard.astro';
import { getMountainsWithImages } from '../lib/data';

const mountainsWithImages = getMountainsWithImages(6);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "UK Mountains – Guides, Peaks, Maps & Highest Mountains in the UK",
  "description": "Discover UK mountains with detailed guides, maps, and rankings of the highest mountains in the UK. Explore routes, tips, and must-see peaks.",
  "url": "https://ukmountains.directory",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://ukmountains.directory/?search={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const organizationData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "UK Mountains Directory",
  "url": "https://ukmountains.directory",
  "logo": "https://ukmountains.directory/favicon.svg",
  "description": "The comprehensive guide to UK mountains"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are the highest mountains in the UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The highest mountains in the UK include Ben Nevis (1,345m), Snowdon (1,085m), and Scafell Pike (978m), with full rankings available in our directory."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I see the highest mountains in the UK in order?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can view a complete ranked list of the highest mountains in the UK in order on our dedicated mountains page."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best UK mountain for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Easier beginner-friendly mountains include Pen y Fan, Catbells, and Mam Tor due to clear paths and gentler gradients."
      }
    },
    {
      "@type": "Question",
      "name": "What equipment do I need to climb UK mountains?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Basic equipment includes boots, layers, navigation tools, water, and safety gear. Winter climbs may require crampons and ice axes."
      }
    },
    {
      "@type": "Question",
      "name": "Are UK mountains safe for children?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes—many lower peaks are family-friendly, but always check weather conditions and route difficulty before climbing."
      }
    }
  ]
};
---

<Layout
  title="UK Mountains – Guides, Peaks, Maps & Highest Mountains in the UK"
  description="Discover UK mountains with detailed guides, maps, and rankings of the highest mountains in the UK. Explore routes, tips, and must-see peaks."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationData)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="hero">
    <div class="hero-background"></div>
    <div class="hero-content">
      <div class="container">
        <h1 class="hero-title">Explore the Best UK Mountains: Maps, Guides & Peak Rankings</h1>
        <p class="hero-subtitle">
          Discover the beauty, scale, and history of UK mountains with the most complete peak directory online. Whether you're planning your next hike, researching the highest mountains in the UK, or simply exploring iconic peaks, our platform provides accurate data, maps, rankings, and adventure tips.
        </p>
        <SearchBar />
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="container">
      <div class="intro-content">
        <h2>Welcome to the Ultimate UK Mountains Directory</h2>
        <p>
          Discover the beauty, scale, and history of UK mountains with the most complete peak directory online. Whether you're planning your next hike, researching the highest mountains in the UK, or simply exploring iconic peaks, our platform provides accurate data, maps, rankings, and adventure tips.
        </p>
        <p>
          From Scotland's dramatic Munros to England's rugged Lake District summits, we help mountain lovers, hikers, climbers, and photographers explore the best nature has to offer.
        </p>
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <h2>Featured Mountain Guides</h2>
        <p>Dive into in-depth guides covering peak difficulty, best routes, parking information, safety tips, recommended seasons to climb, and nearby activities. These guides help beginners and experienced climbers explore UK mountains confidently.</p>
      </div>

      <div id="mountains-grid" class="mountains-grid">
        {mountainsWithImages.length > 0 ? (
          mountainsWithImages.map((mountain) => (
            <MountainCard mountain={mountain} />
          ))
        ) : (
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
            </svg>
            <h3>No Mountains Found</h3>
            <p>Start exploring by adding mountain data to the database.</p>
          </div>
        )}
      </div>

      <div id="loading-state" class="loading-state" style="display: none;">
        <div class="spinner"></div>
        <p>Loading mountains...</p>
      </div>
    </div>
  </section>

  <section class="beginner-peaks-section">
    <div class="container">
      <h2>Looking for Beginner-Friendly Peaks?</h2>
      <p>
        If you're just getting started, check out our guides to the most <strong>easy mountains to climb UK</strong>, including routes, maps, time estimates, and difficulty breakdowns. These are ideal for:
      </p>
      <div class="beginner-list">
        <div class="beginner-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>First-time climbers</span>
        </div>
        <div class="beginner-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Families with children</span>
        </div>
        <div class="beginner-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Casual weekend hikers</span>
        </div>
        <div class="beginner-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Photography trips</span>
        </div>
        <div class="beginner-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Beginners testing their fitness</span>
        </div>
        <div class="beginner-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Solo hikers seeking accessible routes</span>
        </div>
      </div>
      <a href="/mountains" class="btn btn-primary explore-btn">Explore Mountains Directory</a>
    </div>
  </section>

  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">⛰️</div>
          <div class="stat-number" id="munros-count">21</div>
          <div class="stat-label">Munros</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🏔️</div>
          <div class="stat-number" id="corbetts-count">9</div>
          <div class="stat-label">Corbetts</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🗻</div>
          <div class="stat-number" id="marilyns-count">37</div>
          <div class="stat-label">Marilyns</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">📍</div>
          <div class="stat-number" id="total-count">71</div>
          <div class="stat-label">Total Mountains</div>
        </div>
      </div>
    </div>
  </section>

  <section class="why-choose-section">
    <div class="container">
      <h2>Start Exploring the UK's Greatest Peaks</h2>
      <div class="why-choose-content">
        <p>
          Whether your goal is to climb the highest mountains UK peak-by-peak or to explore hidden gems across Scotland, Wales, England and Northern Ireland, our platform gives you everything you need to plan your journey.
        </p>
        <p>
          We combine expert insights with real local knowledge for the most trustworthy content. Stay updated with mountain safety tips, seasonal climbing advice, gear reviews, hiking route breakdowns, and weather updates for popular mountains.
        </p>
        <div class="cta-buttons">
          <a href="/mountains" class="btn btn-primary">View All Mountains</a>
          <a href="/about" class="btn btn-secondary">Learn More About Us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-container">
        <details class="faq-item">
          <summary>What are the highest mountains in the UK?</summary>
          <p>
            The highest mountains in the UK include Ben Nevis (1,345m), Snowdon (1,085m), and Scafell Pike (978m), with full rankings available in our directory. Ben Nevis in Scotland is the tallest peak in the entire United Kingdom, while Snowdon is the highest in Wales and Scafell Pike tops England's peaks.
          </p>
        </details>

        <details class="faq-item">
          <summary>Where can I see the highest mountains in the UK in order?</summary>
          <p>
            You can view a complete ranked list of the highest mountains in the UK in order on our dedicated <a href="/mountains">mountains page</a>. Our directory includes detailed height information, location data, and climbing difficulty for each peak, making it easy to plan your next mountain adventure.
          </p>
        </details>

        <details class="faq-item">
          <summary>What is the best UK mountain for beginners?</summary>
          <p>
            Easier beginner-friendly mountains include Pen y Fan in Wales, Catbells in the Lake District, and Mam Tor in the Peak District due to clear paths and gentler gradients. These mountains offer stunning views without requiring technical climbing skills, making them perfect for families and first-time hikers.
          </p>
        </details>

        <details class="faq-item">
          <summary>What equipment do I need to climb UK mountains?</summary>
          <p>
            Basic equipment includes hiking boots with good ankle support, waterproof layers, navigation tools (map and compass or GPS), water, snacks, and safety gear including a first aid kit and emergency whistle. Winter climbs may require crampons, ice axes, and additional winter clothing. Always check the weather forecast and inform someone of your plans before setting out.
          </p>
        </details>

        <details class="faq-item">
          <summary>Are UK mountains safe for children?</summary>
          <p>
            Yes—many lower peaks are family-friendly, but always check weather conditions and route difficulty before climbing. Mountains like Pen y Fan, Catbells, and the lower Lake District fells offer excellent family hiking opportunities with well-maintained paths and manageable distances. Start with easier peaks and gradually build up to more challenging climbs as children gain experience and confidence.
          </p>
        </details>

        <details class="faq-item">
          <summary>What is a Munro and how many are there?</summary>
          <p>
            A Munro is a Scottish mountain over 3,000 feet (914.4 meters) in height. There are 282 Munros in Scotland, named after Sir Hugh Munro who first catalogued them in 1891. Completing all Munros, known as "Munro bagging," is a popular challenge among hillwalkers and mountaineers.
          </p>
        </details>

        <details class="faq-item">
          <summary>When is the best time to climb the highest mountains in the UK?</summary>
          <p>
            Summer (June-August) offers the most stable weather and longest daylight hours, making it ideal for climbing the highest mountains UK has to offer. However, spring and autumn provide fewer crowds and beautiful scenery. Winter climbing requires advanced skills and specialized equipment but rewards climbers with spectacular snow-covered landscapes.
          </p>
        </details>

        <details class="faq-item">
          <summary>Do I need permission to climb UK mountains?</summary>
          <p>
            Most UK mountains are accessible under Right to Roam legislation (England and Wales) or Scottish Access Rights. However, some areas may have temporary restrictions during deer stalking season (August-October in Scotland) or for conservation reasons. Always check local access information and respect any closure notices or private land restrictions.
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { searchMountains, getMountainImages } from '../lib/data';

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const nearMeBtn = document.getElementById('near-me-btn') as HTMLButtonElement;
  const regionFilters = document.querySelectorAll('.region-filter');
  const classFilters = document.querySelectorAll('.class-filter');
  const diffFilters = document.querySelectorAll('.diff-filter');
  const mountainsGrid = document.getElementById('mountains-grid');
  const loadingState = document.getElementById('loading-state');

  let currentRegion = 'all';
  let currentClassification = 'all';
  let currentDifficulty = 'all';
  let userLocation: { latitude: number; longitude: number } | null = null;

  function calculateDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a =
      Math.sin(dLat/2) * Math.sin(dLat/2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  function performSearch(query: string = '') {
    if (mountainsGrid && loadingState) {
      mountainsGrid.style.display = 'none';
      loadingState.style.display = 'flex';

      const filtered = searchMountains(
        query,
        currentRegion,
        currentClassification,
        currentDifficulty
      ).slice(0, 50);

      const mountainsWithImages = filtered.map(m => {
        const images = getMountainImages(m.id);
        return {
          ...m,
          image_url: images[0]?.image_url,
          mountain_images: images
        };
      });

      loadingState.style.display = 'none';
      mountainsGrid.style.display = 'grid';

      if (mountainsWithImages && mountainsWithImages.length > 0) {
        mountainsGrid.innerHTML = mountainsWithImages.map((mountain: any) => `
          <a href="/mountain/${mountain.slug}" class="mountain-card">
            <div class="card-image">
              <img src="${mountain.mountain_images?.[0]?.image_url || 'https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=800'}" alt="${mountain.name}" loading="lazy">
              ${mountain.classification ? `<span class="badge">${mountain.classification}</span>` : ''}
            </div>
            <div class="card-content">
              <h3>${mountain.name}</h3>
              <div class="card-meta">
                <span class="meta-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline>
                    <polyline points="16 17 22 17 22 11"></polyline>
                  </svg>
                  ${mountain.height_meters}m (${mountain.height_feet}ft)
                </span>
                <span class="meta-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  ${mountain.region}
                </span>
              </div>
              ${mountain.description ? `<p class="card-description">${mountain.description.substring(0, 120)}${mountain.description.length > 120 ? '...' : ''}</p>` : ''}
            </div>
          </a>
        `).join('');
      } else {
        mountainsGrid.innerHTML = `
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
            </svg>
            <h3>No Mountains Found</h3>
            <p>Try adjusting your search or filters.</p>
          </div>
        `;
      }
    }
  }

  if (searchInput) {
    let debounceTimer: number;
    searchInput.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const query = (e.target as HTMLInputElement).value;
        performSearch(query);
      }, 300);
    });
  }

  regionFilters.forEach(chip => {
    chip.addEventListener('click', () => {
      regionFilters.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentRegion = chip.getAttribute('data-filter') || 'all';
      performSearch(searchInput?.value || '');
    });
  });

  classFilters.forEach(chip => {
    chip.addEventListener('click', () => {
      classFilters.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentClassification = chip.getAttribute('data-filter') || 'all';
      performSearch(searchInput?.value || '');
    });
  });

  diffFilters.forEach(chip => {
    chip.addEventListener('click', () => {
      diffFilters.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentDifficulty = chip.getAttribute('data-filter') || 'all';
      performSearch(searchInput?.value || '');
    });
  });

  if (nearMeBtn) {
    nearMeBtn.addEventListener('click', async () => {
      if (!('geolocation' in navigator)) {
        alert('Location services are not supported by your browser. Please try a different browser or manually search for mountains in your area.');
        return;
      }

      nearMeBtn.disabled = true;
      nearMeBtn.innerHTML = '<div class="spinner-small"></div> Finding...';
      nearMeBtn.setAttribute('aria-busy', 'true');

      navigator.geolocation.getCurrentPosition(
        async (position) => {
            userLocation = {
              latitude: position.coords.latitude,
              longitude: position.coords.longitude
            };

            if (mountainsGrid && loadingState) {
              mountainsGrid.style.display = 'none';
              loadingState.style.display = 'flex';

              const allMountains = searchMountains('', 'all', 'all', 'all');

              if (allMountains && userLocation) {
                const mountainsWithDistance = allMountains.map((m: any) => {
                  const images = getMountainImages(m.id);
                  return {
                    ...m,
                    image_url: images[0]?.image_url,
                    mountain_images: images,
                    distance: calculateDistance(
                      userLocation.latitude,
                      userLocation.longitude,
                      parseFloat(m.latitude),
                      parseFloat(m.longitude)
                    )
                  };
                }).sort((a, b) => a.distance - b.distance).slice(0, 20);

                loadingState.style.display = 'none';
                mountainsGrid.style.display = 'grid';

                mountainsGrid.innerHTML = mountainsWithDistance.map((mountain: any) => `
                  <a href="/mountain/${mountain.slug}" class="mountain-card">
                    <div class="card-image">
                      <img src="${mountain.mountain_images?.[0]?.image_url || 'https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=800'}" alt="${mountain.name}" loading="lazy">
                      ${mountain.classification ? `<span class="badge">${mountain.classification}</span>` : ''}
                    </div>
                    <div class="card-content">
                      <h3>${mountain.name}</h3>
                      <div class="card-meta">
                        <span class="meta-item">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline>
                            <polyline points="16 17 22 17 22 11"></polyline>
                          </svg>
                          ${mountain.height_meters}m
                        </span>
                        <span class="meta-item">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          ${mountain.distance.toFixed(1)} km away
                        </span>
                      </div>
                    </div>
                  </a>
                `).join('');
              }
            }

            nearMeBtn.disabled = false;
            nearMeBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg> Near Me';
            nearMeBtn.removeAttribute('aria-busy');
          },
          (error) => {
            let errorMessage = 'Unable to access your location. ';

            if (error.code === error.PERMISSION_DENIED) {
              errorMessage += 'Please enable location permissions in your browser settings.';
            } else if (error.code === error.POSITION_UNAVAILABLE) {
              errorMessage += 'Location information is unavailable. Please try again.';
            } else if (error.code === error.TIMEOUT) {
              errorMessage += 'Location request timed out. Please try again.';
            }

            alert(errorMessage);
            nearMeBtn.disabled = false;
            nearMeBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg> Near Me';
            nearMeBtn.removeAttribute('aria-busy');
          }
        );
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    background-image: url('https://images.pexels.com/photos/2662116/pexels-photo-2662116.jpeg?auto=compress&cs=tinysrgb&w=1920');
    background-size: cover;
    background-position: center;
    opacity: 0.15;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--spacing-3xl) 0;
    text-align: center;
  }

  .hero-title {
    color: white;
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: var(--spacing-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .hero-subtitle {
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-2xl);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
  }

  .intro-section {
    padding: var(--spacing-3xl) 0;
    background: white;
  }

  .intro-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .intro-content h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-xl);
    color: var(--color-neutral-900);
  }

  .intro-content p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-neutral-700);
    margin-bottom: var(--spacing-lg);
  }

  .featured-section {
    padding: var(--spacing-3xl) 0;
    background: white;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .section-header h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-md);
  }

