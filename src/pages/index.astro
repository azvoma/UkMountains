---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import MountainCard from '../components/MountainCard.astro';
import { getMountainsWithImages } from '../lib/data';

const mountainsWithImages = getMountainsWithImages(6);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "UK Mountains Directory",
  "description": "Comprehensive directory of UK mountains including Munros, Corbetts, Wainwrights, and more",
  "url": "https://ukmountains.directory",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://ukmountains.directory/?search={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const organizationData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "UK Mountains Directory",
  "url": "https://ukmountains.directory",
  "logo": "https://ukmountains.directory/favicon.svg",
  "description": "The comprehensive guide to UK mountains"
};
---

<Layout
  title="UK Mountains Directory - Explore the Peaks of Britain"
  description="Discover and explore the mountains of the United Kingdom. Search for mountains by location, height, and features. Find detailed information about every peak."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationData)} />
  <section class="hero">
    <div class="hero-background"></div>
    <div class="hero-content">
      <div class="container">
        <h1 class="hero-title">Discover the Mountains of the UK</h1>
        <p class="hero-subtitle">
          Explore comprehensive information about every peak, from the mighty Munros of Scotland to the historic mountains of Wales and England. Our extensive database features detailed guides, routes, historical facts, and practical information for all major UK mountains. Whether you're planning your first hill walk or completing your Munro round, find everything you need to make your mountain adventure safe and memorable. Discover heights, locations, difficulty ratings, best seasons to visit, parking information, and much more for hundreds of peaks across the United Kingdom.
        </p>
        <SearchBar />
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="container">
      <div class="intro-content">
        <h2>Your Gateway to UK Mountain Adventures</h2>
        <p>
          Welcome to the UK's most comprehensive mountain directory. Whether you're an experienced mountaineer tackling Munros,
          a weekend walker exploring local peaks, or a nature enthusiast discovering Britain's stunning landscapes, we provide
          the essential information you need. Our carefully curated database includes detailed descriptions, route information,
          historical context, and practical advice for hundreds of mountains across England, Scotland, and Wales.
        </p>
        <p>
          From the towering heights of Ben Nevis to the dramatic ridges of Snowdonia, from the rugged beauty of the Lake District
          to the remote wilderness of the Scottish Highlands, discover the diversity and majesty of UK mountains. Each mountain
          page offers comprehensive details including elevation data, GPS coordinates, parking facilities, difficulty ratings,
          weather considerations, and interesting facts to enrich your climbing experience.
        </p>
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <h2>Featured Mountains</h2>
        <p>Explore some of the most iconic peaks across the United Kingdom</p>
      </div>

      <div id="mountains-grid" class="mountains-grid">
        {mountainsWithImages.length > 0 ? (
          mountainsWithImages.map((mountain) => (
            <MountainCard mountain={mountain} />
          ))
        ) : (
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
            </svg>
            <h3>No Mountains Found</h3>
            <p>Start exploring by adding mountain data to the database.</p>
          </div>
        )}
      </div>

      <div id="loading-state" class="loading-state" style="display: none;">
        <div class="spinner"></div>
        <p>Loading mountains...</p>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">⛰️</div>
          <div class="stat-number">282</div>
          <div class="stat-label">Munros</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🏔️</div>
          <div class="stat-number">222</div>
          <div class="stat-label">Corbetts</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🗻</div>
          <div class="stat-number">1556</div>
          <div class="stat-label">Marilyns</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">📍</div>
          <div class="stat-number">All UK</div>
          <div class="stat-label">Regions</div>
        </div>
      </div>
    </div>
  </section>

  <section class="why-choose-section">
    <div class="container">
      <h1>Why Choose UK Mountains Directory?</h1>
      <div class="why-choose-content">
        <p>
          UK Mountains Directory stands as the most comprehensive and reliable resource for mountain enthusiasts across the United Kingdom.
          We've meticulously compiled data on hundreds of peaks, creating an invaluable tool for anyone looking to explore Britain's
          stunning mountain landscapes. Our platform combines accurate geographical data with practical hiking information, historical
          insights, and safety guidance to ensure every mountain adventure is well-planned and memorable.
        </p>
        <p>
          What sets us apart is our commitment to providing detailed, verified information that goes beyond basic statistics. Each mountain
          profile includes route descriptions, parking details, weather considerations, nearby facilities, and fascinating historical facts.
          Whether you're planning a challenging winter ascent or a family-friendly summer walk, our database helps you make informed
          decisions and discover new peaks to conquer. Join thousands of mountain enthusiasts who trust UK Mountains Directory for their
          outdoor adventures.
        </p>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-container">
        <details class="faq-item">
          <summary>What is a Munro and how many are there in Scotland?</summary>
          <p>
            A Munro is a Scottish mountain over 3,000 feet (914.4 meters) in height. Named after Sir Hugh Munro who first catalogued
            them in 1891, there are 282 Munros in Scotland. Completing all Munros is a popular challenge among hillwalkers, known as
            "Munro bagging." Each Munro offers unique challenges and stunning views, from the iconic Ben Nevis to remote peaks in the
            Northwest Highlands.
          </p>
        </details>

        <details class="faq-item">
          <summary>What equipment do I need for UK mountain hiking?</summary>
          <p>
            Essential equipment includes proper hiking boots with ankle support, waterproof jacket and trousers, warm layers, map and
            compass (and the knowledge to use them), first aid kit, torch, emergency whistle, and sufficient food and water. In winter,
            additional equipment like crampons, ice axe, and winter clothing may be necessary. Always check weather forecasts and inform
            someone of your plans before setting out.
          </p>
        </details>

        <details class="faq-item">
          <summary>When is the best time to climb UK mountains?</summary>
          <p>
            The best time varies by mountain and personal preference. Summer (June-August) offers the longest daylight hours and generally
            more stable weather, making it ideal for beginners. Spring and autumn provide fewer crowds and beautiful colors. Winter climbing
            requires additional skills and equipment but offers spectacular snow-covered landscapes. Always check specific mountain conditions
            and weather forecasts regardless of season.
          </p>
        </details>

        <details class="faq-item">
          <summary>Are dogs allowed on UK mountains?</summary>
          <p>
            Dogs are generally allowed on most UK mountains, but they must be kept under close control, especially around livestock during
            lambing season (March-May). Some nature reserves and protected areas may have restrictions. Always keep your dog on a lead near
            sheep, clean up after them, and consider their fitness level for the terrain. Check specific mountain regulations before your visit.
          </p>
        </details>

        <details class="faq-item">
          <summary>Do I need special permission to climb UK mountains?</summary>
          <p>
            Most UK mountains are accessible under Right to Roam legislation (England and Wales) or Scottish Access Rights. However, some
            areas may have temporary restrictions during deer stalking season (August-October in Scotland) or for conservation reasons.
            Always check local access information, follow the Countryside Code, and respect any closure notices. Private land may require
            permission from landowners.
          </p>
        </details>

        <details class="faq-item">
          <summary>How do I find parking for mountain walks?</summary>
          <p>
            Most popular mountains have designated car parks, which may be free or require payment. Our mountain pages include specific
            parking postcodes for GPS navigation. Arrive early on weekends and holidays as car parks fill quickly. Always park considerately,
            don't block gates or access roads, and never leave valuables visible in your vehicle. Some remote mountains may only have roadside
            parking areas.
          </p>
        </details>

        <details class="faq-item">
          <summary>What should I do in an emergency on a mountain?</summary>
          <p>
            In an emergency, call 999 or 112 and ask for Police, then Mountain Rescue. Provide your exact location (grid reference if possible),
            describe the emergency, and the number of people in your group. Stay where you are unless it's unsafe. Keep the casualty warm and
            comfortable. If you have a whistle, use the international distress signal: six blasts, one-minute pause, repeat. Modern smartphones
            can provide location coordinates even without signal.
          </p>
        </details>

        <details class="faq-item">
          <summary>Can beginners climb UK mountains?</summary>
          <p>
            Absolutely! The UK offers mountains suitable for all experience levels. Start with well-maintained paths on lower peaks, gradually
            building fitness and confidence. Popular beginner-friendly mountains include Ben Lomond, Pen y Fan, and some Lake District fells.
            Always choose routes appropriate for your fitness level, check weather forecasts, go with experienced friends if possible, and
            never hesitate to turn back if conditions deteriorate or you feel uncomfortable.
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { searchMountains, getMountainImages } from '../lib/data';

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const nearMeBtn = document.getElementById('near-me-btn') as HTMLButtonElement;
  const regionFilters = document.querySelectorAll('.region-filter');
  const classFilters = document.querySelectorAll('.class-filter');
  const diffFilters = document.querySelectorAll('.diff-filter');
  const mountainsGrid = document.getElementById('mountains-grid');
  const loadingState = document.getElementById('loading-state');

  let currentRegion = 'all';
  let currentClassification = 'all';
  let currentDifficulty = 'all';
  let userLocation: { latitude: number; longitude: number } | null = null;

  function calculateDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a =
      Math.sin(dLat/2) * Math.sin(dLat/2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  function performSearch(query: string = '') {
    if (mountainsGrid && loadingState) {
      mountainsGrid.style.display = 'none';
      loadingState.style.display = 'flex';

      const filtered = searchMountains(
        query,
        currentRegion,
        currentClassification,
        currentDifficulty
      ).slice(0, 50);

      const mountainsWithImages = filtered.map(m => {
        const images = getMountainImages(m.id);
        return {
          ...m,
          mountain_images: images
        };
      });

      loadingState.style.display = 'none';
      mountainsGrid.style.display = 'grid';

      if (mountainsWithImages && mountainsWithImages.length > 0) {
        mountainsGrid.innerHTML = mountainsWithImages.map((mountain: any) => `
          <a href="/mountain/${mountain.slug}" class="mountain-card">
            <div class="card-image">
              <img src="${mountain.mountain_images?.[0]?.image_url || 'https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=800'}" alt="${mountain.name}" loading="lazy">
              ${mountain.classification ? `<span class="badge">${mountain.classification}</span>` : ''}
            </div>
            <div class="card-content">
              <h3>${mountain.name}</h3>
              <div class="card-meta">
                <span class="meta-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline>
                    <polyline points="16 17 22 17 22 11"></polyline>
                  </svg>
                  ${mountain.height_meters}m (${mountain.height_feet}ft)
                </span>
                <span class="meta-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  ${mountain.region}
                </span>
              </div>
              ${mountain.description ? `<p class="card-description">${mountain.description.substring(0, 120)}${mountain.description.length > 120 ? '...' : ''}</p>` : ''}
            </div>
          </a>
        `).join('');
      } else {
        mountainsGrid.innerHTML = `
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
            </svg>
            <h3>No Mountains Found</h3>
            <p>Try adjusting your search or filters.</p>
          </div>
        `;
      }
    }
  }

  if (searchInput) {
    let debounceTimer: number;
    searchInput.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const query = (e.target as HTMLInputElement).value;
        performSearch(query);
      }, 300);
    });
  }

  regionFilters.forEach(chip => {
    chip.addEventListener('click', () => {
      regionFilters.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentRegion = chip.getAttribute('data-filter') || 'all';
      performSearch(searchInput?.value || '');
    });
  });

  classFilters.forEach(chip => {
    chip.addEventListener('click', () => {
      classFilters.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentClassification = chip.getAttribute('data-filter') || 'all';
      performSearch(searchInput?.value || '');
    });
  });

  diffFilters.forEach(chip => {
    chip.addEventListener('click', () => {
      diffFilters.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentDifficulty = chip.getAttribute('data-filter') || 'all';
      performSearch(searchInput?.value || '');
    });
  });

  if (nearMeBtn) {
    nearMeBtn.addEventListener('click', async () => {
      if (!('geolocation' in navigator)) {
        alert('Location services are not supported by your browser. Please try a different browser or manually search for mountains in your area.');
        return;
      }

      nearMeBtn.disabled = true;
      nearMeBtn.innerHTML = '<div class="spinner-small"></div> Finding...';
      nearMeBtn.setAttribute('aria-busy', 'true');

      navigator.geolocation.getCurrentPosition(
        async (position) => {
            userLocation = {
              latitude: position.coords.latitude,
              longitude: position.coords.longitude
            };

            if (mountainsGrid && loadingState) {
              mountainsGrid.style.display = 'none';
              loadingState.style.display = 'flex';

              const allMountains = searchMountains('', 'all', 'all', 'all');

              if (allMountains && userLocation) {
                const mountainsWithDistance = allMountains.map((m: any) => {
                  const images = getMountainImages(m.id);
                  return {
                    ...m,
                    mountain_images: images,
                    distance: calculateDistance(
                      userLocation.latitude,
                      userLocation.longitude,
                      parseFloat(m.latitude),
                      parseFloat(m.longitude)
                    )
                  };
                }).sort((a, b) => a.distance - b.distance).slice(0, 20);

                loadingState.style.display = 'none';
                mountainsGrid.style.display = 'grid';

                mountainsGrid.innerHTML = mountainsWithDistance.map((mountain: any) => `
                  <a href="/mountain/${mountain.slug}" class="mountain-card">
                    <div class="card-image">
                      <img src="${mountain.mountain_images?.[0]?.image_url || 'https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=800'}" alt="${mountain.name}" loading="lazy">
                      ${mountain.classification ? `<span class="badge">${mountain.classification}</span>` : ''}
                    </div>
                    <div class="card-content">
                      <h3>${mountain.name}</h3>
                      <div class="card-meta">
                        <span class="meta-item">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline>
                            <polyline points="16 17 22 17 22 11"></polyline>
                          </svg>
                          ${mountain.height_meters}m
                        </span>
                        <span class="meta-item">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          ${mountain.distance.toFixed(1)} km away
                        </span>
                      </div>
                    </div>
                  </a>
                `).join('');
              }
            }

            nearMeBtn.disabled = false;
            nearMeBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg> Near Me';
            nearMeBtn.removeAttribute('aria-busy');
          },
          (error) => {
            let errorMessage = 'Unable to access your location. ';

            if (error.code === error.PERMISSION_DENIED) {
              errorMessage += 'Please enable location permissions in your browser settings.';
            } else if (error.code === error.POSITION_UNAVAILABLE) {
              errorMessage += 'Location information is unavailable. Please try again.';
            } else if (error.code === error.TIMEOUT) {
              errorMessage += 'Location request timed out. Please try again.';
            }

            alert(errorMessage);
            nearMeBtn.disabled = false;
            nearMeBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg> Near Me';
            nearMeBtn.removeAttribute('aria-busy');
          }
        );
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    background-image: url('https://images.pexels.com/photos/2662116/pexels-photo-2662116.jpeg?auto=compress&cs=tinysrgb&w=1920');
    background-size: cover;
    background-position: center;
    opacity: 0.15;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--spacing-3xl) 0;
    text-align: center;
  }

  .hero-title {
    color: white;
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: var(--spacing-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .hero-subtitle {
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-2xl);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
  }

  .intro-section {
    padding: var(--spacing-3xl) 0;
    background: white;
  }

  .intro-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .intro-content h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-xl);
    color: var(--color-neutral-900);
  }

  .intro-content p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-neutral-700);
    margin-bottom: var(--spacing-lg);
  }

  .featured-section {
    padding: var(--spacing-3xl) 0;
    background: var(--color-neutral-50);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .section-header h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-md);
  }

  .section-header p {
    font-size: 1.125rem;
    color: var(--color-neutral-600);
  }

  .mountains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-xl);
  }

  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-3xl);
    gap: var(--spacing-md);
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--color-neutral-200);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .spinner-small {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    display: inline-block;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--spacing-3xl);
  }

  .empty-state svg {
    margin: 0 auto var(--spacing-lg);
    color: var(--color-neutral-400);
  }

  .empty-state h3 {
    color: var(--color-neutral-700);
    margin-bottom: var(--spacing-sm);
  }

  .empty-state p {
    color: var(--color-neutral-500);
  }

  .stats-section {
    padding: var(--spacing-3xl) 0;
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
    margin-top: var(--spacing-3xl);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-xl);
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl);
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .stat-icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-md);
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    margin-bottom: var(--spacing-xs);
  }

  .stat-label {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    font-weight: 500;
  }

  .why-choose-section {
    padding: var(--spacing-3xl) 0;
    background: white;
  }

  .why-choose-section h1 {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: var(--spacing-xl);
    color: var(--color-neutral-900);
  }

  .why-choose-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .why-choose-content p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-neutral-700);
    margin-bottom: var(--spacing-lg);
  }

  .faq-section {
    padding: var(--spacing-3xl) 0;
    background: var(--color-neutral-50);
  }

