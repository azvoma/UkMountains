---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import MountainCard from '../components/MountainCard.astro';
import { getMountainsWithImages, getAllMountains } from '../lib/data';

const mountainsWithImages = getMountainsWithImages(6);
const allMts = getAllMountains();
const allMountainNames = JSON.stringify(allMts.map(m => m.name));
const allMountainSlugs = JSON.stringify(Object.fromEntries(allMts.map(m => [m.name, m.slug])));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "UK Mountains – Guides, Peaks, Maps & Highest Mountains in the UK",
  "description": "Discover UK mountains with detailed guides, maps, and rankings of the highest mountains in the UK. Explore routes, tips, and must-see peaks.",
  "url": "https://ukmountains.directory",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://ukmountains.directory/?search={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const organizationData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "UK Mountains Directory",
  "url": "https://ukmountains.directory",
  "logo": "https://ukmountains.directory/favicon.svg",
  "description": "The comprehensive guide to UK mountains"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are the highest mountains in the UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The highest mountains in the UK include Ben Nevis (1,345m), Snowdon (1,085m), and Scafell Pike (978m), with full rankings available in our directory."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I see the highest mountains in the UK in order?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can view a complete ranked list of the highest mountains in the UK in order on our dedicated mountains page."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best UK mountain for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Easier beginner-friendly mountains include Pen y Fan, Catbells, and Mam Tor due to clear paths and gentler gradients."
      }
    },
    {
      "@type": "Question",
      "name": "What equipment do I need to climb UK mountains?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Basic equipment includes boots, layers, navigation tools, water, and safety gear. Winter climbs may require crampons and ice axes."
      }
    },
    {
      "@type": "Question",
      "name": "Are UK mountains safe for children?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes—many lower peaks are family-friendly, but always check weather conditions and route difficulty before climbing."
      }
    },
    {
      "@type": "Question",
      "name": "How many Munros are in England?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "None. A Munro is defined specifically as a Scottish mountain over 3,000ft (914.4m), named after Sir Hugh Munro, who catalogued them in 1891. England's mountains are classified separately — mainly as Wainwrights (Lake District) or Hewitts — so \"Munros in England\" isn't a category that exists, even though it's a common search."
      }
    },
    {
      "@type": "Question",
      "name": "What are the main British mountain ranges?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The main ranges are the Grampian Mountains and Cairngorms in Scotland, Snowdonia in Wales, the Lake District fells and the Pennines in England, and the Mourne Mountains in Northern Ireland. Each has its own classification system."
      }
    }
  ]
};
---

<Layout
  title="UK Mountains Map: Explore Every UK Mountain Range Today"
  description="Explore the UK mountains map covering every range from the Highlands to Snowdonia. See the three highest peaks in the UK. Start exploring now."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationData)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="hero">
    <div class="hero-background"></div>
    <div class="hero-content">
      <div class="container">
        <h1 class="hero-title">UK Mountains Map: Your Directory to Every Peak and Range</h1>
        <p class="hero-subtitle">
          Looking for a UK mountains map that actually tells you what you're looking at? This directory covers every major range across England, Scotland, Wales and Northern Ireland — where the ranges are, which peaks are the highest, and what's near you. The three highest mountains in the UK — Ben Nevis, Ben Macdui and Braeriach — are all in Scotland.
        </p>
        <SearchBar mountainNames={allMountainNames} mountainSlugs={allMountainSlugs} />
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="container">
      <div class="intro-content">
        <h2>Where the UK's Mountain Ranges Actually Are</h2>
        <p>
          Britain's high ground isn't evenly spread — it clusters into a handful of named ranges, and knowing them makes the rest of this map much easier to read.
        </p>
        <ul class="range-list">
          <li><strong>Scottish Highlands</strong> — the Northwest Highlands, the Grampian Mountains (including the Cairngorms), and the Southern Uplands. This is where almost all of the UK's highest ground sits.</li>
          <li><strong>Cambrian Mountains &amp; Snowdonia (Eryri)</strong> — Wales' main mountain country, home to Snowdon/Yr Wyddfa and Cadair Idris.</li>
          <li><strong>Pennines &amp; Cumbrian Mountains (Lake District)</strong> — England's principal upland spine, running from the Peak District north to the Scottish border.</li>
          <li><strong>Mourne Mountains</strong> — Northern Ireland's highest range, home to Slieve Donard.</li>
        </ul>
        <p>
          A summit generally needs to reach around 600m (2,000 ft) before it's widely accepted as a mountain rather than a hill — which is exactly why areas like Kent and London, both well under that height, have hills rather than mountains.
        </p>
        <p>
          From Scotland's dramatic Munros to England's rugged Lake District summits, we help hikers, climbers, and photographers explore the best of British mountain ranges. For the complete ranked list of the highest mountains in the UK, detailed definitions, and classification breakdowns, visit our dedicated <a href="/mountains/">UK mountains guide</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <h2>Featured UK Mountain Guides</h2>
        <p>Dive into in-depth guides covering peak difficulty, best routes, parking information, safety tips, recommended seasons to climb, and nearby activities. These guides help beginners and experienced climbers explore UK mountains confidently.</p>
      </div>

      <div id="mountains-grid" class="mountains-grid">
        {mountainsWithImages.length > 0 ? (
          mountainsWithImages.map((mountain) => (
            <MountainCard mountain={mountain} />
          ))
        ) : (
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
            </svg>
            <h3>No Mountains Found</h3>
            <p>Start exploring by adding mountain data to the database.</p>
          </div>
