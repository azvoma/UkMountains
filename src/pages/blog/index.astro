---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllBlogArticles } from '../../data/blog';

const articles = getAllBlogArticles();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ukmountains.directory/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://ukmountains.directory/blog/" }
  ]
};

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "UK Mountains Blog",
  "description": "Expert hiking guides, route descriptions, and mountain reference articles for UK peaks.",
  "url": "https://ukmountains.directory/blog/",
  "publisher": {
    "@type": "Organization",
    "name": "UK Mountains Directory"
  }
};
---

<Layout
  title="UK Mountains Blog \u2013 Hiking Guides & Route Advice"
  description="Expert UK mountain hiking guides, route descriptions, height rankings, and safety advice. Explore Ben Nevis, Cadair Idris, and famous UK peaks."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <section class="blog-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="container">
        <Breadcrumbs items={[
          { name: 'Home', url: '/' },
          { name: 'Blog' }
        ]} />
        <h1>UK Mountains Blog</h1>
        <p class="hero-subtitle">
          Expert hiking guides, route descriptions, height rankings, and safety advice for exploring the peaks of Britain. Written by qualified mountain leaders with real UK mountaineering experience.
        </p>
      </div>
    </div>
  </section>

  <section class="blog-listing">
    <div class="container">
      <div class="section-header">
        <h2>All Articles</h2>
        <p>Browse our complete collection of UK mountain guides, from route-specific walkthroughs to comprehensive peak rankings and regional overviews.</p>
      </div>

      <div class="blog-grid">
        {articles.map((article) => (
          <BlogCard article={article} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: center;
    color: white;
    overflow: hidden;
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background-image: url('https://images.pexels.com/photos/2662116/pexels-photo-2662116.jpeg?auto=compress&cs=tinysrgb&w=1920');
    background-size: cover;
    background-position: center;
    opacity: 0.15;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--spacing-3xl) 0;
    text-align: center;
  }

  .hero-content h1 {
    color: white;
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: var(--spacing-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .hero-subtitle {
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.15rem;
    max-width: 800px;
    line-height: 1.7;
    margin: 0 auto;
  }

  :global(.hero-content .breadcrumb-list) {
    justify-content: center;
  }

  .blog-listing {
    padding: var(--spacing-3xl) 0;
    background: var(--color-neutral-50);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .section-header h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
  }

  .section-header p {
    font-size: 1.05rem;
    color: var(--color-neutral-600);
    max-width: 700px;
    margin: 0 auto;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-xl);
  }

  @media (max-width: 768px) {
    .hero-content h1 {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>
