---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Thanks – We Have Your Message | UK Mountains Directory"
  description="Thanks for contacting UK Mountains Directory. We reply to every message within two business days."
  noindex={true}
>
  <div class="thanks-wrap">
    <h1>Thanks, your message is on its way</h1>
    <p>We reply to every message within two business days. If you sent a correction, we will check it against our sources and update the page when it is confirmed.</p>
    <p><a href="/mountains/">Browse all mountains</a> or <a href="/">return to the homepage</a>.</p>
  </div>
</Layout>

<style>
  .thanks-wrap { max-width: 640px; margin: 4rem auto; padding: 0 1.25rem; line-height: 1.7; }
</style>
