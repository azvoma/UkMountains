---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About the Mountains in UK",
  "description": "Learn about our mission to showcase the mountains in UK, including guides, tall mountains, UK mountains maps, and complete peak data.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How many mountains in UK are listed in your directory?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We provide a complete and regularly updated list covering all mountain classifications across England, Scotland, Wales, and Northern Ireland."
      }
    },
    {
      "@type": "Question",
      "name": "What are the tallest mountains in UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ben Nevis, Snowdon, and Scafell Pike are among the tallest mountains in UK, with full comparisons available in our peak database."
      }
    },
    {
      "@type": "Question",
      "name": "Does your site include a UK mountains map?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we include an interactive UK mountains map with filters for height, region, difficulty, and popularity."
      }
    },
    {
      "@type": "Question",
      "name": "Why is accurate mountain data important?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Accurate information helps hikers plan safely, choose appropriate routes, and understand the terrain and conditions before setting off."
      }
    }
  ]
};
---

<Layout
  title="The Mountains in UK – About Our Mission & Mountain Guides"
  description="Learn about our mission to showcase the mountains in UK, from tall peaks to complete UK mountains maps, guides, and expert resources."
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="about-page">
    <div class="about-hero">
      <div class="container">
        <Breadcrumbs items={[
          { name: 'Home', url: '/' },
          { name: 'About' }
        ]} />
        <h1>About Our Mission to Showcase the Mountains in UK</h1>
        <p class="hero-text">
          Discover accurate guides, maps, and expert resources for every peak across the United Kingdom
        </p>
      </div>
    </div>

    <div class="container">
      <div class="about-content">
        <section class="content-section">
          <h2>Who We Are</h2>
          <p>
            Welcome to the most comprehensive online resource dedicated to the mountains in UK. Our mission is simple: to help explorers, hikers, and nature lovers discover the beauty, history, height, and geography of the country's most iconic peaks.
          </p>
          <p>
            From Scotland's rugged Highlands to the dramatic landscapes of Wales and the scenic mountains of England and Northern Ireland, we focus on bringing accurate, engaging, and up-to-date information to every adventurer.
          </p>
        </section>

        <section class="content-section">
          <h2>Why We Created This UK Mountains Platform</h2>
          <p>
            As outdoor enthusiasts, we noticed that many websites provided incomplete or outdated information about the mountains in UK. Our goal was to build a central hub for:
          </p>
          <ul class="features-list">
            <li>Peak data and elevation comparisons</li>
            <li>Guides to tall mountains in UK</li>
            <li>Expert climbing tips and safety advice</li>
            <li>Easy-to-read UK mountains map tools</li>
            <li>Step-by-step hiking routes</li>
          </ul>
          <p>
            We combine verified data, real-world hiking experience, and advanced mapping technology to create a platform you can trust.
          </p>
        </section>

        <section class="content-section">
          <h2>What Makes Our Information Reliable</h2>
          <div class="section-with-image">
            <div class="section-text">
              <p>
                We believe accurate mountain information saves time—and sometimes lives. Our database includes thoroughly researched facts such as:
              </p>
              <ul class="features-list">
                <li>How many mountains in UK (with full lists per country)</li>
                <li>Elevation measurements verified through Ordnance Survey</li>
                <li>Regional mountain classifications (Munros, Corbetts, Hewitts, etc.)</li>
                <li>Weather patterns & seasonal conditions</li>
                <li>Difficulty grades for all major peaks</li>
              </ul>
              <p>
                We update our guides regularly, ensuring you always have the most trustworthy details at your fingertips.
              </p>
            </div>
            <div class="section-image">
              <img src="/Ben Nevis 2.jpg" alt="Mountain landscape view" />
            </div>
          </div>
        </section>

        <section class="content-section">
          <h2>Our Mission: Inspire & Educate Mountain Lovers</h2>
          <p>
            We aim to make exploring the mountains in UK accessible to everyone. Whether you're a beginner looking for your first summit or an experienced climber tackling the highest peaks, we're here to support your journey.
          </p>
          <h3>Our Mission Pillars</h3>
          <div class="mission-pillars">
            <div class="pillar-item">
              <div class="pillar-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <h4>Accuracy</h4>
              <p>Verified, researched mountain data</p>
            </div>
            <div class="pillar-item">
              <div class="pillar-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </div>
              <h4>Accessibility</h4>
              <p>Easy-to-use maps and guides</p>
            </div>
            <div class="pillar-item">
              <div class="pillar-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                </svg>
              </div>
              <h4>Adventure</h4>
              <p>Inspiring stories & stunning photography</p>
            </div>
            <div class="pillar-item">
              <div class="pillar-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <h4>Safety</h4>
              <p>Practical tips for all ability levels</p>
            </div>
          </div>
        </section>

        <section class="content-section">
          <h2>Our UK Mountains Map & Tools</h2>
          <p>
            To help you explore visually, we provide an interactive UK mountains map that allows you to:
          </p>
          <ul class="features-list">
            <li>Locate peaks by region</li>
            <li>Filter mountains by height</li>
            <li>Compare tall mountains in UK</li>
            <li>View routes, difficulty & GPS coordinates</li>
            <li>Check weather updates near summits</li>
          </ul>
          <p>
            This map is designed for walkers, hikers, families, climbers and peak-baggers wanting to find their next challenge.
          </p>
        </section>

        <section class="content-section">
          <h2>Meet the Team Behind the Project</h2>
          <div class="section-with-image">
            <div class="section-image">
              <img src="/Gemini_Generated_Image_5mbsgf5mbsgf5mbs.png" alt="UK Mountains Directory team" />
            </div>
            <div class="section-text">
              <p>
                Our team is made up of:
              </p>
              <ul class="features-list">
                <li>Experienced hikers</li>
                <li>Data analysts</li>
                <li>Outdoor photographers</li>
                <li>Cartographers</li>
                <li>Web designers and researchers</li>
              </ul>
              <p>
                Together, we ensure our platform delivers depth, accuracy, and the passion of true mountain enthusiasts.
              </p>
            </div>
          </div>
        </section>

        <section class="content-section">
          <h2>Our Promise to the Mountain Community</h2>
          <p>
            We are committed to continuously expanding our directory to cover every major and minor peak. As more people search for details like how many mountains in UK or want to explore maps of tall mountains, our platform will grow to meet that need.
          </p>
          <p>
            We update our guides regularly, work with local communities, conservation groups, and experienced mountaineers to ensure our information remains current and accurate. If you notice any inaccuracies or have suggestions for improvements, please <a href="/contact">contact us</a>.
          </p>
        </section>

        <section class="content-section cta-section">
          <h2>Start Exploring the Mountains in UK</h2>
          <p>
            Ready to discover the beauty, scale, and history of the mountains in UK? Start your journey today and find your next adventure with our comprehensive guides and interactive maps.
          </p>
          <a href="/mountains" class="btn btn-primary">Explore All Mountains</a>
        </section>

        <section class="faq-section content-section">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-container">
            <details class="faq-item">
              <summary>How many mountains in UK are listed in your directory?</summary>
              <p>
                We provide a complete and regularly updated list covering all mountain classifications across England, Scotland, Wales, and Northern Ireland. Our directory includes Munros, Corbetts, Marilyns, Wainwrights, and many other significant peaks, giving you access to comprehensive data about the mountains in UK.
              </p>
            </details>

            <details class="faq-item">
              <summary>What are the tallest mountains in UK?</summary>
              <p>
                Ben Nevis (1,345m), Snowdon (1,085m), and Scafell Pike (978m) are among the tallest mountains in UK, with full comparisons available in our <a href="/mountains">peak database</a>. We provide detailed information about height rankings, difficulty levels, and climbing routes for all major peaks.
              </p>
            </details>

            <details class="faq-item">
              <summary>Does your site include a UK mountains map?</summary>
              <p>
                Yes, we include an interactive UK mountains map with filters for height, region, difficulty, and popularity. Our map helps you locate peaks by region, compare tall mountains in UK, view routes and GPS coordinates, and plan your next mountain adventure with confidence.
              </p>
            </details>

            <details class="faq-item">
              <summary>Why is accurate mountain data important?</summary>
              <p>
                Accurate information helps hikers plan safely, choose appropriate routes, and understand the terrain and conditions before setting off. Reliable data about the mountains in UK can save time and sometimes lives, which is why we verify all elevation measurements through Ordnance Survey and regularly update our guides.
              </p>
            </details>

            <details class="faq-item">
              <summary>How do you ensure the accuracy of mountain information?</summary>
              <p>
                We use data from authoritative sources including Ordnance Survey, Scottish Mountaineering Club, and other recognized mountain organizations. Our team regularly reviews and verifies information, and we welcome feedback from users to help us maintain accuracy. When heights or classifications are updated by official bodies, we update our database accordingly.
              </p>
            </details>

            <details class="faq-item">
              <summary>Is UK Mountains Directory free to use?</summary>
              <p>
                Absolutely! UK Mountains Directory is completely free to access and use. We believe information about the mountains in UK should be accessible to everyone. There are no hidden fees, subscriptions, or paywalls. Our goal is to support the mountain community by providing comprehensive, reliable information at no cost.
              </p>
            </details>

            <details class="faq-item">
              <summary>Can I contribute information or photos?</summary>
              <p>
                Yes! We welcome contributions from the mountain community. If you have photos, route updates, or additional information about any mountain in the UK, please <a href="/contact">contact us</a>. While we can't guarantee all submissions will be used, we review each one carefully and appreciate community input in keeping our directory comprehensive and current.
              </p>
            </details>

            <details class="faq-item">
              <summary>How often do you add new mountains to the directory?</summary>
              <p>
                We continuously expand our database to include more mountains in UK. Priority is given to classified peaks (Munros, Corbetts, Marilyns, Wainwrights, etc.), but we're also adding prominent regional peaks. New mountains are added after thorough research to ensure comprehensive and accurate information. Check back regularly to discover newly added peaks.
              </p>
            </details>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-page {
    background: var(--color-neutral-50);
  }

  .about-hero {
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
    padding: var(--spacing-3xl) 0;
    text-align: center;
    margin-bottom: var(--spacing-3xl);
  }

  .about-hero h1 {
    color: white;
    font-size: 3rem;
    margin-bottom: var(--spacing-md);
  }

  :global(.about-hero .breadcrumb-list) {
    justify-content: center;
  }

  .hero-text {
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .about-content {
    max-width: 900px;
    margin: 0 auto;
    padding-bottom: var(--spacing-3xl);
  }

  .content-section {
    background: white;
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-bottom: var(--spacing-xl);
  }

  .content-section h2 {
    color: var(--color-neutral-900);
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
  }

  .content-section p {
    line-height: 1.7;
    color: var(--color-neutral-700);
    margin-bottom: var(--spacing-md);
    font-size: 1.05rem;
  }

  .content-section h3 {
    color: var(--color-neutral-900);
    font-size: 1.5rem;
    margin: var(--spacing-lg) 0 var(--spacing-md) 0;
  }

  .features-list {
    background: var(--color-neutral-50);
    padding: var(--spacing-lg);
    border-radius: var(--radius-md);
    margin: var(--spacing-md) 0;
    border-left: 4px solid var(--color-primary);
  }

  .features-list li {
    margin-bottom: var(--spacing-sm);
    color: var(--color-neutral-700);
    line-height: 1.6;
  }

  .features-list li:last-child {
    margin-bottom: 0;
  }

  .mission-pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }

  .pillar-item {
    padding: var(--spacing-lg);
    background: var(--color-neutral-50);
    border-radius: var(--radius-md);
    text-align: center;
    border: 2px solid var(--color-primary);
    transition: all var(--transition-base);
  }

  .pillar-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: #0a5c3d;
  }

  .pillar-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: rgba(15, 118, 110, 0.1);
    border-radius: 50%;
    margin: 0 auto var(--spacing-md);
    color: var(--color-primary);
  }

  .pillar-item h4 {
    color: var(--color-primary);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
  }

  .pillar-item p {
    font-size: 0.95rem;
    margin: 0;
    color: var(--color-neutral-600);
  }

  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  }

  .cta-section h2 {
    color: white;
  }

  .cta-section p {
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: var(--spacing-lg);
  }

  .cta-section .btn {
    background: white;
    color: var(--color-primary);
  }

  .cta-section .btn:hover {
    background: var(--color-neutral-100);
    transform: translateY(-2px);
  }

  .content-section a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .content-section a:hover {
    text-decoration: underline;
  }

  .faq-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
  }

  .faq-item {
    background: var(--color-neutral-50);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    transition: all var(--transition-base);
    border: 1px solid var(--color-neutral-200);
  }

  .faq-item:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .faq-item summary {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-neutral-900);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    color: var(--color-primary);
    transition: transform var(--transition-base);
    flex-shrink: 0;
    margin-left: var(--spacing-md);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin-top: var(--spacing-md);
    line-height: 1.6;
    color: var(--color-neutral-700);
  }

  .faq-item a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .faq-item a:hover {
    text-decoration: underline;
  }

  .section-with-image {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .section-image {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .section-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .section-image img:hover {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .about-hero h1 {
      font-size: 1.75rem;
      line-height: 1.3;
    }

    .hero-text {
      font-size: 1rem;
    }

    .content-section h2 {
      font-size: 1.75rem;
    }

    .content-section h3 {
      font-size: 1.25rem;
    }

    .mission-pillars {
      grid-template-columns: repeat(2, 1fr);
    }

    .content-section p {
      font-size: 1rem;
    }

    .section-with-image {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>
