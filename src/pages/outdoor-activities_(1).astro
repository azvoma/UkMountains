---
// ============================================================================
// MOUNTAIN ACTIVITIES HUB PAGE
// Place this file at: src/pages/outdoor-activities.astro
// ----------------------------------------------------------------------------
// SEO METHOD NOTE:
// Yoast is a WordPress plugin and doesn't run on Astro. What follows applies
// the same checklist Yoast enforces — focus keyphrase in title/H1/meta/first
// paragraph, keyword in image alt text, natural keyword density, internal
// linking — written directly into the markup instead of plugin fields.
//
// KEYWORD DATA SOURCE: user-supplied Ahrefs export (GB, Aug 2026), 125
// keywords. It split into exactly two real clusters — Fort William/Ben Nevis
// accommodation (48 kw) and climbing/mountaineering gear (75 kw, incl. a
// sunglasses sub-cluster). Hire Car, Wild Camping, and Travel Insurance are
// NOT covered by this export — see the flags on those sections below before
// treating their copy as keyword-verified.
//
// SETUP CHECKLIST before publishing:
// 1. Adjust the Layout import path/props to match your real layout.
// 2. Every widget below is SAMPLE DATA, clearly labelled "SAMPLE" rather than
//    "LIVE". Do not relabel as live until a real API is wired in:
//      - Conditions trackers: Met Office DataPoint, MWIS (mwis.org.uk),
//        or the Met Office Mountain Area Forecasts.
//      - Winter/avalanche tracker: SAIS (sais.gov.uk) — Nov–Apr only,
//        show an off-season state outside that window.
//      - Sunset/wind for wild camping: Met Office or OpenWeather +
//        a sunrise-sunset API.
//    Mountain conditions are safety-critical — do not ship this page with
//    "LIVE" labelling on data that isn't actually live.
// 3. Replace affiliate hrefs (currently "#") with real product links —
//    specific products, not search results pages, per your affiliate rules.
// 4. Replace sponsored listing content once you have paying partners;
//    until then these can stay as "Coming soon — contact us to feature
//    your business" placeholders instead of fabricated businesses if you'd
//    rather not publish invented names.
// 5. Swap booking/search widget placeholders for real embeds:
//      - Wild camping/bothy booking: FareHarbor / Peek / Bokun / GetYourGuide.
//      - Car hire search: Discover Cars / RentalCars.com / Skyscanner.
//      - Hotel search: Booking.com or Expedia affiliate widget.
// 6. Insurance and car hire comparison rows use invented but realistic
//    providers/prices as layout placeholders — verify real current pricing
//    and your actual affiliate/referral links before publishing.
// 7. Uses the same design tokens as partner-with-us.astro for site-wide
//    consistency — keep both files' CSS custom properties in sync, or
//    better, move them into a shared global stylesheet.
// 8. Section hero images use placeholder src paths under /images/sections/.
//    Source real CC BY-SA photos via Wikimedia Commons or Geograph.org.uk —
//    same workflow you already use for mountain_images — and verify each
//    filename against the actual Commons category page before publishing;
//    do not construct filenames from a pattern.
// 9. Replace every [AUTHOR NAME] / [REVIEWER NAME] / [DATE] placeholder with
//    a real person and real dates. A fabricated byline is worse for E-E-A-T
//    than no byline at all — only publish credentials that are true.
// ============================================================================

import Layout from '../layouts/Layout.astro'; // adjust path if different

const seo = {
  title: 'UK Mountain Activities Guide | Hotels, Gear & Conditions',
  description:
    'Plan your UK mountain trip: accommodation in Fort William, climbing equipment, hillwalking gear, live conditions and local guides across all four nations.',
  canonical: 'https://www.ukmountainsdirectory.co.uk/outdoor-activities/',
};

// ----------------------------------------------------------------------------
// SECTION KEYWORD MAP — single source of truth for on-page SEO decisions.
// Volume/difficulty figures are from the Aug 2026 Ahrefs export (GB) where
// marked "verified"; everything else is unverified and flagged accordingly.
// ----------------------------------------------------------------------------
const sectionSEO = {
  hotels: {
    primary: { kw: 'accommodation in fort william', kd: 26, vol: 910 },
    secondary: [
      { kw: 'fort william lodges', kd: 6, vol: 590 },
      { kw: 'ben nevis accommodation', kd: 11, vol: 590 },
      { kw: 'hotels near ben nevis', kd: 16, vol: 590 },
      { kw: 'ben nevis where to stay', kd: 15, vol: 590 },
      { kw: 'hotels close to ben nevis', kd: 12, vol: 590 },
      { kw: 'cottage fort william', kd: 10, vol: 480 },
      { kw: 'camping sites fort william scotland', kd: 19, vol: 590 },
      { kw: 'accommodation near ben nevis', kd: 12, vol: 480 },
    ],
    status: 'verified — 48-keyword cluster in export',
  },
  scrambling: {
    primary: { kw: 'climbing equipment', kd: 21, vol: 880 },
    secondary: [
      { kw: 'mountain climbing equipment', kd: 0, vol: 320 },
      { kw: 'mountaineering equipment sale', kd: 9, vol: 480 },
      { kw: 'mount equipment', kd: 16, vol: 540 },
      { kw: 'rock climbing training equipment', kd: 5, vol: 140 },
      { kw: 'uk climbing shop', kd: 19, vol: 320 },
      { kw: 'climbing gear retailers', kd: 17, vol: 170 },
      { kw: 'mountains equipment', kd: 21, vol: 540 },
      { kw: 'sunglasses for mountaineering', kd: 6, vol: 480 },
    ],
    status: 'verified — 75-keyword cluster in export',
  },
  hillwalking: {
    primary: { kw: 'hiking sunglasses', kd: 6, vol: 290 },
    secondary: [{ kw: 'hiking sunglasses women', kd: 6, vol: 390 }],
    status: 'partial — only 2 relevant terms in export; boots/jackets/routes need a dedicated export',
  },
  hireCar: { primary: null, secondary: [], status: 'NOT COVERED — run a dedicated export before optimising' },
  wildCamping: { primary: null, secondary: [], status: 'NOT COVERED — run a dedicated export before optimising' },
  travelInsurance: { primary: null, secondary: [], status: 'NOT COVERED — run a dedicated export before optimising' },
};

const navPills = [
  { href: '#hire-car', label: 'Hire Car' },
  { href: '#hotels', label: 'Hotels' },
  { href: '#hillwalking', label: 'Hillwalking & Hiking' },
  { href: '#scrambling', label: 'Scrambling & Climbing' },
  { href: '#wild-camping', label: 'Wild Camping' },
  { href: '#travel-insurance', label: 'Travel Insurance' },
];

// ---------------------------------------------------------------- Section 1
const hireCarRegions = [
  { region: 'Scottish Highlands', pickup: 'Glasgow or Inverness Airport', detail: '~2hr drive to Fort William / Ben Nevis' },
  { region: 'Snowdonia', pickup: 'Manchester or Liverpool Airport', detail: '~1.5hr drive to Pen y Pass' },
  { region: 'Lake District', pickup: 'Manchester Airport', detail: '~1.5hr drive to Wasdale / Scafell Pike' },
  { region: 'Mourne Mountains', pickup: 'Belfast Airport', detail: '~1hr drive to Newcastle, Co. Down' },
];

const hireCarComparison = [
  { company: 'Enterprise', priceFrom: '£28/day', note: 'Wide UK airport coverage' },
  { company: 'Europcar', priceFrom: '£25/day', note: 'Good one-way rental options' },
  { company: 'Hertz', priceFrom: '£32/day', note: 'Free cancellation on most rates' },
  { company: 'Sixt', priceFrom: '£30/day', note: 'Newer fleet, higher-spec options' },
];

// ---------------------------------------------------------------- Section 2
const hotelRegions = [
  { region: 'Fort William, Scotland', priceFrom: '£70/night' },
  { region: 'Betws-y-Coed, Wales', priceFrom: '£65/night' },
  { region: 'Keswick, Lake District', priceFrom: '£80/night' },
  { region: 'Newcastle, Co. Down', priceFrom: '£60/night' },
];

// ---------------------------------------------------------------- Section 3
const hillwalkingConditions = [
  { name: 'Ben Nevis', nation: 'Scotland', status: 'good', detail: 'Clear summit, light wind' },
  { name: 'Yr Wyddfa (Snowdon)', nation: 'Wales', status: 'caution', detail: '40mph gusts forecast above 800m' },
  { name: 'Scafell Pike', nation: 'England', status: 'good', detail: 'Dry, visibility 10km+' },
  { name: 'Slieve Donard', nation: 'Northern Ireland', status: 'avoid', detail: 'Storm warning from 2pm' },
];

const jacketComparison = [
  { brand: 'Alpkit Balance', price: '£120', rating: 4 },
  { brand: 'Berghaus Deluge Pro', price: '£90', rating: 3 },
  { brand: 'Rab Downpour Eco', price: '£75', rating: 3 },
  { brand: 'Mountain Warehouse Pakka', price: '£45', rating: 2 },
];

const accommodationListings = [
  { name: 'Ben Nevis Bunkhouse', location: 'Fort William, Scotland', desc: "Walker-friendly bunkhouse, 10 minutes from the Ben Nevis path." },
  { name: 'Pen y Pass Hostel', location: 'Snowdonia, Wales', desc: "Trailhead stay for Yr Wyddfa's Pyg and Miners' tracks." },
  { name: 'Wasdale Head Inn', location: 'Lake District, England', desc: 'Historic inn beneath Scafell Pike, boot room and drying facilities.' },
  { name: 'Donard Lodge B&B', location: 'Newcastle, Co. Down', desc: 'B&B at the base of the Mourne Mountains.' },
];

const hillwalkingLinks = [
  { label: 'Ben Nevis route guide', href: '/mountains/ben-nevis/' },
  { label: 'Yr Wyddfa (Snowdon) route guide', href: '/mountains/snowdon/' },
  { label: 'Scafell Pike route guide', href: '/mountains/scafell-pike/' },
  { label: 'Slieve Donard route guide', href: '/mountains/slieve-donard/' },
];

// ---------------------------------------------------------------- Section 4
const winterConditions = [
  { region: 'Cairngorms', level: 'considerable' },
  { region: 'Glencoe', level: 'high' },
  { region: 'Torridon', level: 'low' },
  { region: 'Lochaber', level: 'considerable' },
];

const climbingGear = [
  { name: 'Petzl Meteor Helmet', price: '£75', pro: 'Ultralight, well ventilated', con: 'Premium price' },
  { name: 'Black Diamond Half Dome', price: '£55', pro: 'Durable, easy to adjust', con: 'Heavier on long routes' },
  { name: 'Petzl Corax Harness', price: '£50', pro: 'Comfortable, versatile', con: 'Bulkier for scrambling' },
  { name: 'Edelrid Loopo Harness', price: '£40', pro: 'Great value', con: 'Basic gear loops' },
  { name: 'DMM Shadow Harness', price: '£65', pro: 'Lightweight, scrambling-specific', con: 'Less padding on belays' },
];

const guideListings = [
  { name: 'Glenmore Lodge', location: 'Cairngorms, Scotland', desc: 'Winter skills, scrambling and mountaineering courses.' },
  { name: 'Plas y Brenin', location: 'Snowdonia, Wales', desc: 'National Mountain Centre — scrambling and navigation courses.' },
  { name: 'Lake District Mountain Guides', location: 'Cumbria, England', desc: 'Private guiding on Scafell Pike scrambles and winter routes.' },
  { name: 'Mourne Mountain Guides', location: 'Co. Down, NI', desc: 'Guided scrambling and hillwalking across the Mournes.' },
];

// ---------------------------------------------------------------- Section 5
const campingConditions = [
  { region: 'Cairngorms', wind: '18mph', low: '3°C', sunset: '21:14' },
  { region: 'Snowdonia', wind: '12mph', low: '8°C', sunset: '21:32' },
  { region: 'Lake District', wind: '9mph', low: '9°C', sunset: '21:20' },
  { region: 'Mourne Mountains', wind: '15mph', low: '7°C', sunset: '21:05' },
];

const tentGrid = [
  { name: 'Vango Soul 100', price: '£120' },
  { name: 'Alpkit Ordos 2', price: '£180' },
  { name: 'Decathlon MT500', price: '£150' },
  { name: 'Wild Country Zephyros 1', price: '£220' },
];

const campingLinks = [
  { label: 'Wild camping in Scotland: know before you go', href: '/guides/wild-camping-scotland/' },
  { label: 'All UK mountain guides', href: '/mountains/' },
];

// ---------------------------------------------------------------- Section 6
const insuranceComparison = [
  { provider: 'Snowcard Insurance', coverage: 'Hillwalking & scrambling to Grade 3, medical & repatriation costs', priceFrom: '£45' },
  { provider: 'BMC Travel & Activity Insurance', coverage: 'Hillwalking, climbing & mountaineering, third-party liability', priceFrom: '£38' },
  { provider: 'Global Rescue', coverage: 'Emergency evacuation in remote areas outside the UK', priceFrom: '£89' },
  { provider: 'Battleface', coverage: 'Adventure travel with customisable activity add-ons', priceFrom: '£30' },
];

const statusLabel = { good: 'Good', caution: 'Caution', avoid: 'Avoid' };
const levelLabel = { low: 'Low', considerable: 'Considerable', high: 'High' };

// Replace every bracketed value with a real person and real dates before
// publishing. schema.org has no "reviewedBy" property — the review claim
// lives in the visible byline only, not in structured data.
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  description: seo.description,
  url: seo.canonical,
  author: { '@type': 'Person', name: '[AUTHOR NAME]', jobTitle: '[e.g. Mountain Leader / Hillwalking Guide]' },
  datePublished: '[YYYY-MM-DD]',
  dateModified: '[YYYY-MM-DD]',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ukmountainsdirectory.co.uk/' },
      { '@type': 'ListItem', position: 2, name: 'Outdoor Activities', item: seo.canonical },
    ],
  },
};
---

<Layout title={seo.title} description={seo.description}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <main class="oa-page">
    <!-- ============================== HERO ============================== -->
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow">Outdoor Activities</p>
        <h1>The Ultimate Guide to UK Mountain Activities</h1>
        <p class="hero-sub">
          From the Munros of the Highlands to the fells of the Lakes, this hub covers everything
          you need for a safe, rewarding trip in the mountains — getting there and where to stay,
          hillwalking gear and conditions, scrambling and climbing kit, wild camping essentials,
          and cover that actually protects you on the hill.
        </p>
        <div class="hero-pills">
          {navPills.map((p) => (
            <a class="pill" href={p.href}>{p.label}</a>
          ))}
        </div>
      </div>
    </section>

    <p class="eeat-strip">
      Written by <strong>[AUTHOR NAME]</strong>, [e.g. Mountain Leader / hillwalker of N years] ·
      Reviewed by <strong>[REVIEWER NAME]</strong> · Last updated <strong>[DATE]</strong>
    </p>

    <p class="disclosure">
      Some links on this page are affiliate links — we may earn a commission at no extra cost to
      you. Featured accommodation and guide listings are paid placements, marked as such.
    </p>

    <!--
      SEO — Hire Car section
      ⚠️ NOT COVERED by the Aug 2026 Ahrefs export. Copy below is written to
      general best practice, not verified keyword data. Run a dedicated
      export (e.g. "car hire fort william", "car hire snowdonia", "getting
      to ben nevis without a car") before treating this section as optimised.
    -->
    <!-- ========================= SECTION 1: HIRE CAR ========================= -->
    <section class="activity-section" id="hire-car">
      <div class="section-inner">
        <h2>Hire Car & Getting There</h2>
        <p class="section-intro">
          Most UK trailheads sit well beyond the train line. A hire car is often the practical
          way to reach more than one mountain in a trip — here's where to start.
        </p>

        <img
          class="section-image"
          src="/images/sections/hire-car-scottish-highlands.jpg"
          alt="Car parked at a UK mountain trailhead in the Scottish Highlands"
          loading="lazy"
          width="1200"
          height="675"
        />

        <h3 class="block-title">Search Car Hire</h3>
        <p class="block-note">Placeholder for an embedded car hire search widget. Drop in your widget snippet where the box below appears.</p>
        <div class="booking-placeholder">
          <p><strong>Your car hire search widget loads here.</strong></p>
          <p class="muted">e.g. Discover Cars, RentalCars.com, or Skyscanner Car Hire embed.</p>
        </div>

        <h3 class="block-title">Getting to the Trailhead by Region</h3>
        <p class="block-note">Nearest airport and approximate drive time to the mountain.</p>
        <div class="info-grid">
          {hireCarRegions.map((r) => (
            <div class="product-card">
              <p class="product-name">{r.region}</p>
              <p class="sponsored-desc">{r.pickup}</p>
              <p class="condition-detail">{r.detail}</p>
            </div>
          ))}
        </div>

        <h3 class="block-title">Compare Car Hire Providers</h3>
        <p class="block-note">Indicative daily rates — check the provider for current pricing.</p>
        <div class="table-wrap">
          <table class="comparison-table">
            <thead>
              <tr><th>Provider</th><th>Price from</th><th>Notes</th><th></th></tr>
            </thead>
            <tbody>
              {hireCarComparison.map((c) => (
                <tr>
                  <td>{c.company}</td>
                  <td>{c.priceFrom}</td>
                  <td>{c.note}</td>
                  <td><a class="btn btn-small" href="#">Compare</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!--
      SEO — Hotels & Accommodation section (verified cluster, 48 keywords)
      Primary:   accommodation in fort william   (KD 26, vol 910/mo)
      Secondary: fort william lodges (KD 6, 590) · ben nevis accommodation (KD 11, 590) ·
                 hotels near ben nevis (KD 16, 590) · ben nevis where to stay (KD 15, 590) ·
                 hotels close to ben nevis (KD 12, 590) · cottage fort william (KD 10, 480) ·
                 camping sites fort william scotland (KD 19, 590) · accommodation near ben nevis (KD 12, 480)
      Note: this cluster is Fort William/Ben Nevis-specific and is roughly 10x
      deeper than anything found for the other 3 regions in the table below —
      worth considering as its own dedicated landing page, linked from here.
    -->
    <!-- ========================= SECTION 2: HOTELS ========================= -->
    <section class="activity-section alt" id="hotels">
      <div class="section-inner">
        <h2>Hotels & Accommodation Near the Mountains</h2>
        <p class="section-intro">
          Base yourself close to the mountain and start walking sooner. Search accommodation
          across all four nations, or see trailhead-specific stays under Hillwalking below.
        </p>

        <img
          class="section-image"
          src="/images/sections/fort-william-accommodation.jpg"
          alt="Accommodation and hotels near Ben Nevis in Fort William, Scotland"
          loading="lazy"
          width="1200"
          height="675"
        />

        <h3 class="block-title">Accommodation in Fort William: Where to Stay for Ben Nevis</h3>
        <p class="block-note">
          Fort William is the natural base for Ben Nevis, and its accommodation reflects that —
          from budget lodges and bunkhouses to self-catering cottages a short walk from town.
          Whether you're after hotels near Ben Nevis, a cottage in Fort William, or camping sites
          around Fort William, Scotland's outdoor capital has options for every budget and every
          night before an early summit start.
        </p>

        <h3 class="block-title">Search Hotels & Accommodation</h3>
        <p class="block-note">Placeholder for an embedded hotel search widget.</p>
        <div class="booking-placeholder">
          <p><strong>Your hotel search widget loads here.</strong></p>
          <p class="muted">e.g. Booking.com or Expedia affiliate search widget, pre-filtered to mountain regions.</p>
        </div>

        <h3 class="block-title">Popular Base Towns by Region</h3>
        <p class="block-note">Indicative prices — check the provider for current rates.</p>
        <div class="table-wrap">
          <table class="comparison-table">
            <thead>
              <tr><th>Base town</th><th>Price from</th><th></th></tr>
            </thead>
            <tbody>
              {hotelRegions.map((h) => (
                <tr>
                  <td>{h.region}</td>
                  <td>{h.priceFrom}</td>
                  <td><a class="btn btn-small" href="#">Search Hotels</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="related-links">
          Looking for a bunkhouse right at the trailhead? See
          <a href="#hillwalking">featured trailside accommodation near Ben Nevis</a> below.
        </p>
      </div>
    </section>

    <!--
      SEO — Hillwalking section (PARTIAL DATA — only 2 relevant terms found)
      Primary:   hiking sunglasses          (KD 6, vol 290/mo)
      Secondary: hiking sunglasses women    (KD 6, vol 390/mo)
      Boots, jackets, and route-specific terms need a dedicated export before
      this section can be treated as fully keyword-verified.
    -->
    <!-- ========================= SECTION 3: HILLWALKING ========================= -->
    <section class="activity-section" id="hillwalking">
      <div class="section-inner">
        <h2>Hillwalking & Hiking Gear + Conditions</h2>
        <p class="section-intro">
          Conditions on UK mountains can shift fast, even in summer — the right gear, and knowing
          before you go, keeps a good day good.
        </p>

        <img
          class="section-image"
          src="/images/sections/hillwalking-uk-mountains.jpg"
          alt="Hillwalker crossing a UK mountain ridge in waterproof gear"
          loading="lazy"
          width="1200"
          height="675"
        />

        <h3 class="block-title">Mountain Weather & Conditions Tracker</h3>
        <p class="block-note">
          Sample data — swap for Met Office Mountain Area Forecasts or MWIS before launch, and
          keep the "SAMPLE" label until the feed is genuinely live.
        </p>
        <div class="conditions-bar">
          <span class="conditions-bar-label">SAMPLE · UK Mountain Conditions</span>
        </div>
        <div class="conditions-grid">
          {hillwalkingConditions.map((c) => (
            <div class="condition-card">
              <p class="condition-name">{c.name}</p>
              <p class="condition-nation">{c.nation}</p>
              <p class={`condition-status status-${c.status}`}>{statusLabel[c.status]}</p>
              <p class="condition-detail">{c.detail}</p>
            </div>
          ))}
        </div>

        <h3 class="block-title">Waterproof Jackets: Premium vs Budget</h3>
        <p class="block-note">Our top picks, compared. Prices are indicative — check the retailer for current pricing.</p>
        <div class="table-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Brand</th>
                <th>Price</th>
                <th>Waterproofing</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {jacketComparison.map((j) => (
                <tr>
                  <td>{j.brand}</td>
                  <td>{j.price}</td>
                  <td class="stars" aria-label={`${j.rating} out of 5 stars`}>
                    {'★'.repeat(j.rating)}{'☆'.repeat(5 - j.rating)}
                  </td>
                  <td><a class="btn btn-small" href="#">Check Price</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="block-note">
          Don't overlook eye protection — a good pair of hiking sunglasses (or hiking sunglasses
          for women, if you want a smaller frame fit) cuts glare on exposed ridgelines and makes
          a real difference on long summer days above the treeline.
        </p>

        <h3 class="block-title">Featured Trailside Accommodation</h3>
        <p class="block-note">Sample listings — contact us to feature your business.</p>
        <div class="sponsored-grid">
          {accommodationListings.map((a) => (
            <div class="sponsored-card">
              <span class="sponsored-badge">Stay</span>
              <p class="sponsored-name">{a.name}</p>
              <p class="sponsored-location">{a.location}</p>
              <p class="sponsored-desc">{a.desc}</p>
              <a class="btn btn-small btn-primary" href="#">Book Now</a>
            </div>
          ))}
        </div>

        <p class="related-links">
          Looking for the best spots? Read our specific guides for
          {hillwalkingLinks.map((l, i) => (
            <>
              {' '}<a href={l.href}>{l.label}</a>{i < hillwalkingLinks.length - 1 ? ',' : '.'}
            </>
          ))}
        </p>
      </div>
    </section>

    <!--
      SEO — Scrambling & Climbing section (verified cluster, 75 keywords)
      Primary:   climbing equipment              (KD 21, vol 880/mo)
      Secondary: mountain climbing equipment (KD 0!, 320) · mountaineering equipment sale (KD 9, 480) ·
                 mount equipment (KD 16, 540) · rock climbing training equipment (KD 5, 140) ·
                 uk climbing shop (KD 19, 320) · climbing gear retailers (KD 17, 170) ·
                 mountains equipment (KD 21, 540) · sunglasses for mountaineering (KD 6, 480)
      Note: "mountain climbing equipment" shows KD 0 — essentially unclaimed —
      it's the single strongest quick-win in the whole export.
    -->
    <!-- ========================= SECTION 4: SCRAMBLING ========================= -->
    <section class="activity-section alt" id="scrambling">
      <div class="section-inner">
        <h2>Scrambling, Climbing Equipment & Local Guides</h2>
        <p class="section-intro">
          Scrambling rewards good judgement and the right kit. Check conditions, especially in
          winter, before committing to a grade above your comfort.
        </p>

        <img
          class="section-image"
          src="/images/sections/climbing-equipment-uk.jpg"
          alt="Climbing equipment and mountaineering gear laid out for a UK scrambling route"
          loading="lazy"
          width="1200"
          height="675"
        />

        <h3 class="block-title">Winter Conditions & Avalanche Risk</h3>
        <p class="block-note">
          Sample data, Nov–Apr season only — replace with live SAIS (sais.gov.uk) data. Never use
          placeholder figures for real trip planning.
        </p>
        <div class="conditions-bar">
          <span class="conditions-bar-label">SAMPLE · Avalanche Risk by Region</span>
        </div>
        <div class="conditions-grid">
          {winterConditions.map((w) => (
            <div class="condition-card">
              <p class="condition-name">{w.region}</p>
