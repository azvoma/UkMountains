---
import Layout from '../../layouts/Layout.astro';
import NearbyPeaks from '../../components/NearbyPeaks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllMountains, getMountainBySlug, getMountainImages, getMountainRoutes, getNearbyPeaks, type Mountain } from '../../lib/data';

export async function getStaticPaths() {
  const mountains = getAllMountains();
  return mountains.map((mountain) => ({
    params: { slug: mountain.slug },
  }));
}

const { slug } = Astro.params;
const mountain = getMountainBySlug(slug);

if (!mountain) {
  return Astro.redirect('/404');
}

const images = getMountainImages(mountain.id);
const routes = getMountainRoutes(mountain.id);

const mountainRoutes = routes;
const classifications = [];
if (mountain.is_munro) classifications.push('Munro');
if (mountain.is_corbett) classifications.push('Corbett');
if (mountain.is_graham) classifications.push('Graham');
if (mountain.is_wainwright) classifications.push('Wainwright');
if (mountain.is_hewitt) classifications.push('Hewitt');
if (mountain.is_nuttall) classifications.push('Nuttall');
if (mountain.is_marilyn) classifications.push('Marilyn');

const mountainImages = images;
const defaultImages = [
  'https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=1200',
  'https://images.pexels.com/photos/2662116/pexels-photo-2662116.jpeg?auto=compress&cs=tinysrgb&w=1200',
  'https://images.pexels.com/photos/1261728/pexels-photo-1261728.jpeg?auto=compress&cs=tinysrgb&w=1200',
];

const displayImages = mountainImages.length > 0
  ? mountainImages.map(img => img.image_url).slice(0, 2)
  : defaultImages.slice(0, 2);

const difficultyText = mountain.difficulty_rating || 'Moderate';
const seasonText = mountain.best_season || 'Spring to Autumn';

const weatherUrl = `https://www.metoffice.gov.uk/weather/forecast/${mountain.latitude.toFixed(4)},${mountain.longitude.toFixed(4)}`;
const mountainForecastUrl = `https://www.mountain-forecast.com/`;

const nearbyPeaks = getNearbyPeaks(mountain, 4);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ukmountainsdirectory.co.uk/" },
    { "@type": "ListItem", "position": 2, "name": "Mountains", "item": "https://ukmountainsdirectory.co.uk/mountains" },
    { "@type": "ListItem", "position": 3, "name": mountain.name, "item": `https://ukmountainsdirectory.co.uk/mountain/${mountain.slug}` }
  ]
};

const mountainSchema = {
  "@context": "https://schema.org",
  "@type": "Mountain",
  "name": mountain.name,
  "description": mountain.description || `${mountain.name} is a ${mountain.height_meters}m mountain in ${mountain.region}.`,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": mountain.latitude,
    "longitude": mountain.longitude,
    "elevation": mountain.height_meters
  },
  "url": `https://ukmountainsdirectory.co.uk/mountain/${mountain.slug}`,
  "image": displayImages[0] || undefined,
  "address": {
    "@type": "PostalAddress",
    "addressRegion": mountain.region,
    "addressCountry": "GB"
  }
};

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": `${mountain.name} - One of the Mountains in the UK`,
  "description": mountain.description || `A complete guide to ${mountain.name}, one of the mountains in the UK.`,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": mountain.latitude,
    "longitude": mountain.longitude
  },
  "elevation": `${mountain.height_meters} meters`,
  "address": {
    "@type": "PostalAddress",
    "addressRegion": mountain.region,
    "addressCountry": "GB"
  }
};

const fullTitle = `Mountains in the UK – Guide to ${mountain.name}, Routes & Maps`;
const pageTitle = mountain.seo_title || (fullTitle.length > 60
  ? `${mountain.name} – UK Mountain Guide`
  : fullTitle);

const faqSchemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is ${mountain.name} one of the best mountains to climb UK?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, ${mountain.name} is considered one of the best mountains to climb in the UK thanks to its scenic routes, ${mountain.height_meters}m elevation, and ${difficultyText.toLowerCase()} difficulty level.`
      }
    },
    {
      "@type": "Question",
      "name": `What level of difficulty is ${mountain.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${mountain.name} has a difficulty rating of ${difficultyText}. ${mountainRoutes.length > 0 ? 'Multiple routes are available.' : 'Various routes suit different experience levels.'}`
      }
    },
    {
      "@type": "Question",
      "name": `When is the best time to climb ${mountain.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The best season to climb ${mountain.name} is ${seasonText}. Always check the forecast before visiting.`
      }
    },
    ...(mountain.faqs || []).map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  ]
};
---

<Layout
  title={pageTitle}
  description={mountain.seo_description || `Explore ${mountain.name}, one of the mountains in the UK, with routes, difficulty levels, maps, and tips.`}
  image={displayImages[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(mountainSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(touristAttractionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaData)} />

  <!-- HERO -->
  <div class="hero-section">
    <div class="hero-image">
      <img src={displayImages[0]} alt={`${mountain.name} Summit`} onerror="this.onerror=null;this.src='https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=1200'" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content page-wrap">
      <Breadcrumbs items={[
        { name: 'Home', url: '/' },
        { name: 'Mountains', url: '/mountains' },
        { name: mountain.name }
      ]} />
      <h1>{mountain.name}</h1>
      {mountain.national_park && <div class="hero-subtitle">{mountain.national_park}</div>}
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-num">{mountain.height_meters}m</span>
          <span class="stat-lbl">Elevation</span>
        </div>
        <div class="hero-stat">
          <span class="stat-num">{mountain.height_feet}ft</span>
          <span class="stat-lbl">In Feet</span>
        </div>
        {mountain.difficulty_rating && (
          <div class="hero-stat">
            <span class={`difficulty-badge difficulty-${mountain.difficulty_rating.toLowerCase()}`}>{mountain.difficulty_rating}</span>
            <span class="stat-lbl">Difficulty</span>
          </div>
        )}
        {classifications.length > 0 && (
          <div class="hero-stat">
            <span class="stat-num">{classifications[0]}</span>
            <span class="stat-lbl">Classification</span>
          </div>
        )}
      </div>
      <div class="hero-actions">
        <a href="#routes" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          View Routes
        </a>
        <a href={weatherUrl} target="_blank" rel="noopener" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
          Check Weather
        </a>
        <button id="climbed-btn" class="btn btn-climbed" data-slug={mountain.slug} aria-pressed="false">
          <svg id="climbed-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span id="climbed-label">I've Climbed This</span>
        </button>
      </div>
    </div>
  </div>

  <!-- PAGE BODY: sidebar + main -->
  <div class="page-wrap">
    <div class="page-body">

      <!-- SIDEBAR -->
      <aside class="sidebar">

        <!-- Quick Facts -->
        <div class="sidebar-card">
          <h3 class="sidebar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Quick Facts
          </h3>
          <dl class="fact-list">
            <dt>Height</dt>
            <dd>{mountain.height_meters}m / {mountain.height_feet}ft</dd>
            <dt>Region</dt>
            <dd>{mountain.region}{mountain.county ? `, ${mountain.county}` : ''}</dd>
            {mountain.area && <><dt>Area</dt><dd>{mountain.area}</dd></>}
            {mountain.grid_reference && <><dt>OS Grid Ref</dt><dd class="mono">{mountain.grid_reference}</dd></>}
            {mountain.prominence_meters && <><dt>Prominence</dt><dd>{mountain.prominence_meters}m</dd></>}
            {mountain.gaelic_name && <><dt>Gaelic Name</dt><dd>{mountain.gaelic_name}</dd></>}
            {mountain.welsh_name && <><dt>Welsh Name</dt><dd>{mountain.welsh_name}</dd></>}
            {mountain.parent_range && <><dt>Range</dt><dd>{mountain.parent_range}</dd></>}
            <dt>Coordinates</dt>
            <dd class="mono">{mountain.latitude.toFixed(4)}°N, {Math.abs(mountain.longitude).toFixed(4)}°W</dd>
          </dl>
        </div>

        <!-- Classifications -->
        {classifications.length > 0 && (
          <div class="sidebar-card">
            <h3 class="sidebar-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              Classifications
            </h3>
            <div class="tag-group">
              {classifications.map(cls => (
                <span class="cls-tag">{cls}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Weather Links -->
        <div class="sidebar-card sidebar-weather">
          <h3 class="sidebar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
            Weather
          </h3>
          {mountain.best_season && (
            <p class="season-pill">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m4.93-16.93 1.41 1.41M5.66 18.34l1.41 1.41M20 12h2M2 12h2m15.07 7.07 1.41-1.41M5.66 5.66 4.25 4.25"/></svg>
              Best: {mountain.best_season}
            </p>
          )}
          <a href={weatherUrl} target="_blank" rel="noopener" class="weather-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
            Met Office Forecast
          </a>
          <a href={mountainForecastUrl} target="_blank" rel="noopener" class="weather-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
            Mountain Forecast
          </a>
          <div class="weather-note">Summit temps are typically 5–10°C colder than the valley. Always carry waterproofs and warm layers.</div>
        </div>

        <!-- Map -->
        <div class="sidebar-card sidebar-map">
          <h3 class="sidebar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
            Location Map
          </h3>
          <div class="map-thumb">
            <img
              src={`https://api.mapbox.com/styles/v1/mapbox/outdoors-v12/static/pin-s+0f766e(${mountain.longitude},${mountain.latitude})/${mountain.longitude},${mountain.latitude},11,0/400x280@2x?access_token=pk.eyJ1IjoibWFwYm94IiwiYSI6ImNpejY4NXVycTA2emYycXBndHRqcmZ3N3gifQ.rJcFIG214AriISLbB6B5aw`}
              alt={`Map of ${mountain.name}`}
              loading="lazy"
            />
          </div>
          {mountain.parking_postcode && (
            <p class="parking-info">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Parking: <span class="mono">{mountain.parking_postcode}</span>
            </p>
          )}
        </div>

        <!-- Nearby Places -->
        {mountain.nearby_places && mountain.nearby_places.length > 0 && (
          <div class="sidebar-card">
            <h3 class="sidebar-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Nearby Places
            </h3>
            <ul class="nearby-list">
              {mountain.nearby_places.map((place: string) => (
                <li>{place}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Emergency -->
        <div class="sidebar-card sidebar-emergency">
          <h3 class="sidebar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            Emergency
          </h3>
          <p class="emergency-text">Dial <strong>999 or 112</strong> — ask for Police, then Mountain Rescue</p>
        </div>

        <!-- Recommended Gear -->
        <div class="sidebar-card sidebar-gear">
          <h3 class="sidebar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Recommended Gear
          </h3>
          <p class="gear-intro">Essential kit for {mountain.name}:</p>
          <ul class="gear-list">
            <li>
              <a href="https://www.amazon.co.uk/s?k=waterproof+hiking+boots+uk" target="_blank" rel="noopener sponsored" class="gear-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                Best Boots for {mountain.name}
              </a>
            </li>
            <li>
              <a href="https://www.amazon.co.uk/s?k=waterproof+hiking+jacket" target="_blank" rel="noopener sponsored" class="gear-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                Waterproof Jackets
              </a>
            </li>
            <li>
              <a href="https://www.amazon.co.uk/s?k=hiking+poles+lightweight" target="_blank" rel="noopener sponsored" class="gear-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                Lightweight Hiking Poles
              </a>
            </li>
            <li>
              <a href="https://www.amazon.co.uk/s?k=os+map+explorer+mountain" target="_blank" rel="noopener sponsored" class="gear-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                OS Explorer Maps
              </a>
            </li>
            <li>
              <a href="https://www.amazon.co.uk/s?k=hiking+headtorch+led" target="_blank" rel="noopener sponsored" class="gear-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                Head Torches
              </a>
            </li>
          </ul>
          <p class="gear-disclaimer">* Affiliate links — we may earn a small commission at no extra cost to you.</p>
        </div>

      </aside>

      <!-- MAIN CONTENT -->
      <main class="main-content">

        <!-- Overview -->
        {mountain.description && (
          <section class="content-section">
            <h2>About {mountain.name}</h2>
            <p class="lead">{mountain.description}</p>
            {mountain.history && (
              <details class="expand-block">
                <summary>History & Background</summary>
                <p>{mountain.history}</p>
              </details>
            )}
            {mountain.about_extra && (
              <Fragment>
                <p class="lead" set:html={mountain.about_extra.replace(/\n\n/g, '</p><p class="lead">')} />
                {mountain.about_image_todo && <Fragment set:html={mountain.about_image_todo} />}
              </Fragment>
            )}
          </section>
        )}

        <!-- Gallery -->
        <section class="content-section gallery-section">
          <div class="gallery-row">
            {displayImages.map((imageUrl, index) => (
              <div class="gallery-item">
                <img src={imageUrl} alt={`${mountain.name} – view ${index + 1}`} loading="lazy" onerror="this.onerror=null;this.src='https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=1200'" />
              </div>
            ))}
          </div>
        </section>

        <!-- Interesting Facts -->
        {mountain.fun_facts && mountain.fun_facts.length > 0 && (
          <section class="content-section">
            <h2>Interesting Facts</h2>
            <ul class="facts-list">
              {mountain.fun_facts.map((fact: string) => (
                <li>{fact}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- Walking Guide -->
        {mountain.walking_guide && (
          <section class="content-section">
            <h2>Walking Guide</h2>
            <p class="guide-text">{mountain.walking_guide}</p>
          </section>
        )}

        <!-- Routes -->
        {mountainRoutes.length > 0 && (
          <section id="routes" class="content-section">
            <h2>Hiking Routes</h2>
            <p class="section-intro">Choose a route based on your experience and fitness level.</p>
            <div class="routes-list">
              {mountainRoutes.map((route: any) => (
                <div class="route-card">
                  <div class="route-header">
                    <h3>{route.name}</h3>
                    {route.difficulty && (
                      <span class={`difficulty-badge difficulty-${route.difficulty.toLowerCase()}`}>{route.difficulty}</span>
                    )}
                  </div>
                  {route.description && <p class="route-desc">{route.description}</p>}
                  <div class="route-stats">
                    {route.distance_km && (
                      <div class="rstat">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        <span>{route.distance_km} km ({route.distance_miles} mi)</span>
                      </div>
                    )}
                    {route.estimated_time_hours && (
                      <div class="rstat">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span>{route.estimated_time_hours} hrs</span>
                      </div>
                    )}
                    {route.ascent_meters && (
                      <div class="rstat">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                        <span>{route.ascent_meters}m ascent</span>
                      </div>
                    )}
                  </div>
                  {route.starting_point && (
                    <div class="route-start">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      Start: {route.starting_point}{route.postcode ? ` (${route.postcode})` : ''}
                    </div>
                  )}
                  {route.route_notes && <p class="route-notes">{route.route_notes}</p>}
                  {route.seasonal_notes && (
                    <p class="seasonal-note">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/></svg>
                      {route.seasonal_notes}
                    </p>
                  )}
                </div>
              ))}
            </div>
            {mountain.routes_image_todo && <Fragment set:html={mountain.routes_image_todo} />}
          </section>
        )}

        <!-- Extra Sections -->
        {mountain.extra_sections && mountain.extra_sections.length > 0 && (
          mountain.extra_sections.map((sec: any) => (
            <section class="content-section">
              <h2>{sec.title}</h2>
              <div set:html={sec.body.replace(/\n\n/g, '</p><p>').replace(/^/, '<p>').replace(/$/, '</p>')} />
            </section>
          ))
        )}

        <!-- Safety Tips -->
        <section class="content-section">
          <h2>Safety Tips</h2>
