<script>
  const btn = document.getElementById('climbed-btn') as HTMLButtonElement | null;
  if (btn) {
    const slug = btn.dataset.slug || '';
    const key = `climbed-${slug}`;
    const label = document.getElementById('climbed-label');

    function setClimbed(climbed: boolean) {
      if (climbed) {
        btn!.classList.add('climbed');
        btn!.setAttribute('aria-pressed', 'true');
        if (label) label.textContent = 'Climbed!';
        localStorage.setItem(key, '1');
      } else {
        btn!.classList.remove('climbed');
        btn!.setAttribute('aria-pressed', 'false');
        if (label) label.textContent = "I've Climbed This";
        localStorage.removeItem(key);
      }
    }

    setClimbed(localStorage.getItem(key) === '1');

    btn.addEventListener('click', () => {
      setClimbed(localStorage.getItem(key) !== '1');
    });
  }
</script>
