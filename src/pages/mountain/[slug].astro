---
import Layout from '../../layouts/Layout.astro';
import { getAllMountains, getMountainBySlug, getMountainImages, getMountainRoutes, type Mountain } from '../../lib/data';

export async function getStaticPaths() {
  const mountains = getAllMountains();

  return mountains.map((mountain) => ({
    params: { slug: mountain.slug },
  }));
}

const { slug } = Astro.params;
const mountain = getMountainBySlug(slug);

if (!mountain) {
  return Astro.redirect('/404');
}

const images = getMountainImages(mountain.id);
const routes = getMountainRoutes(mountain.id);

const mountainRoutes = routes;
const classifications = [];
if (mountain.is_munro) classifications.push('Munro');
if (mountain.is_corbett) classifications.push('Corbett');
if (mountain.is_graham) classifications.push('Graham');
if (mountain.is_wainwright) classifications.push('Wainwright');
if (mountain.is_hewitt) classifications.push('Hewitt');
if (mountain.is_nuttall) classifications.push('Nuttall');
if (mountain.is_marilyn) classifications.push('Marilyn');

const mountainImages = images;
const defaultImages = [
  'https://images.pexels.com/photos/417074/pexels-photo-417074.jpeg?auto=compress&cs=tinysrgb&w=1200',
  'https://images.pexels.com/photos/2662116/pexels-photo-2662116.jpeg?auto=compress&cs=tinysrgb&w=1200',
  'https://images.pexels.com/photos/1261728/pexels-photo-1261728.jpeg?auto=compress&cs=tinysrgb&w=1200',
  'https://images.pexels.com/photos/1133957/pexels-photo-1133957.jpeg?auto=compress&cs=tinysrgb&w=1200'
];

const displayImages = mountainImages.length > 0
  ? mountainImages.map(img => img.image_url).slice(0, 5)
  : defaultImages.slice(0, 5);

const difficultyText = mountain.difficulty_rating || 'Moderate';
const seasonText = mountain.best_season || 'Spring to Autumn';

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": `${mountain.name} - One of the Mountains in the UK`,
  "description": mountain.description || `A complete guide to ${mountain.name}, one of the mountains in the UK, including routes, maps, difficulty, and tips for climbers.`,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": mountain.latitude,
    "longitude": mountain.longitude
  },
  "elevation": `${mountain.height_meters} meters`,
  "address": {
    "@type": "PostalAddress",
    "addressRegion": mountain.region,
    "addressCountry": "GB"
  }
};

const faqSchemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is ${mountain.name} one of the best mountains to climb UK?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, ${mountain.name} is considered one of the best mountains to climb in the UK thanks to its scenic routes, ${mountain.height_meters}m elevation, and ${difficultyText.toLowerCase()} difficulty level, making it accessible to ${mountain.suitable_for && mountain.suitable_for.length > 0 ? mountain.suitable_for.join(', ').toLowerCase() : 'various skill levels'}.`
      }
    },
    {
      "@type": "Question",
      "name": `What level of difficulty is ${mountain.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${mountain.name} has a difficulty rating of ${difficultyText}. ${mountainRoutes.length > 0 ? 'Multiple routes are available ranging from easier to more challenging options.' : 'The mountain offers various routes suitable for different experience levels.'}`
      }
    },
    {
      "@type": "Question",
      "name": `Where can I see ${mountain.name} on a map?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `You can view ${mountain.name} on our interactive map showing its location in ${mountain.region}. The mountain is positioned at coordinates ${mountain.latitude.toFixed(4)}°N, ${Math.abs(mountain.longitude).toFixed(4)}°W, with detailed route maps and nearby geographical features.`
      }
    },
    {
      "@type": "Question",
      "name": `Are there family-friendly routes on ${mountain.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${mountain.suitable_for && mountain.suitable_for.includes('Families') ? 'Yes, ' + mountain.name + ' has family-friendly routes suitable for those with children, particularly during ' + seasonText.toLowerCase() + ' when conditions are most favorable.' : 'Route suitability depends on experience level and weather conditions. Always assess your group\'s capabilities and check current conditions before setting out.'}`
      }
    },
    {
      "@type": "Question",
      "name": `When is the best time to climb ${mountain.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The best season to climb ${mountain.name} is ${seasonText}. Weather conditions can vary significantly, so always check the forecast before your visit and be prepared for changing mountain weather.`
      }
    }
  ]
};
---

<Layout
  title={`Mountains in the UK – Guide to ${mountain.name}, Routes & Maps`}
  description={`Explore ${mountain.name}, one of the mountains in the UK, with routes, difficulty levels, maps, and tips. Discover the best mountains to climb in the UK for all skill levels.`}
  image={displayImages[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(touristAttractionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaData)} />

  <!-- 1. HERO SECTION -->
  <div class="hero-section">
    <div class="hero-image">
      <img src={displayImages[0]} alt={`${mountain.name} Summit`} />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/mountains">Mountains</a>
        <span>/</span>
        <span>{mountain.name}</span>
      </div>
      <h1>Explore One of the Mountains in the UK: {mountain.name} Guide</h1>
      {mountain.national_park && <div class="hero-subtitle">{mountain.national_park}</div>}
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-value">{mountain.height_meters}m</span>
          <span class="stat-label">Height ({mountain.height_feet}ft)</span>
        </div>
        {mountain.difficulty_rating && (
          <div class="hero-stat">
            <span class={`difficulty-badge difficulty-${mountain.difficulty_rating.toLowerCase()}`}>
              {mountain.difficulty_rating}
            </span>
            <span class="stat-label">Difficulty</span>
          </div>
        )}
      </div>

      <div class="quick-stats">
        {mountain.time_to_summit && (
          <div class="quick-stat">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{mountain.time_to_summit}</span>
          </div>
        )}
        {mountain.route_distance && (
          <div class="quick-stat">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            <span>{mountain.route_distance}</span>
          </div>
        )}
        {mountain.best_season && (
          <div class="quick-stat">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <span>{mountain.best_season}</span>
          </div>
        )}
        {mountain.popular_route_name && (
          <div class="quick-stat">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{mountain.popular_route_name}</span>
          </div>
        )}
        <div class="quick-stat">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span>{mountain.latitude.toFixed(4)}°N, {Math.abs(mountain.longitude).toFixed(4)}°W</span>
        </div>
      </div>

      <div class="hero-actions">
        <a href="#routes" class="btn btn-primary">View Routes</a>
        <a href={`https://www.metoffice.gov.uk/weather/forecast/${mountain.parking_postcode || mountain.grid_reference}`} target="_blank" rel="noopener" class="btn btn-secondary">Check Weather</a>
      </div>
    </div>
  </div>

  <div class="container">
    <!-- 2. MOUNTAIN OVERVIEW -->
    {mountain.description && (
      <section class="section-overview">
        <div class="section-content">
          <h2>Introduction to {mountain.name}</h2>
          <p class="lead">
            {mountain.name} is one of the notable mountains in the UK, known for its unique landscape, scenic routes, and {mountain.famous_for ? mountain.famous_for.toLowerCase() : 'natural beauty'}. Whether you're searching for popular mountains to climb UK, planning your first summit, or exploring the best mountains to climb UK, this guide covers everything you need to know to plan your adventure.
          </p>
          <p class="lead">{mountain.description}</p>

          {mountain.famous_for && (
            <div class="famous-for">
              <h3>Why This Mountain Is Popular</h3>
              <p>This peak is regularly listed among the best mountains to climb UK thanks to its {mountain.famous_for.toLowerCase()}, well-marked routes suitable for different skill levels, and {mountain.nearby_attractions && mountain.nearby_attractions.length > 0 ? 'nearby facilities and attractions' : 'natural setting'}.</p>
            </div>
          )}

          {mountain.landscape_description && (
            <div class="landscape-info">
              <h3>Landscape & Terrain</h3>
              <p>{mountain.landscape_description}</p>
            </div>
          )}

          {mountain.suitable_for && mountain.suitable_for.length > 0 && (
            <div class="suitable-for">
              <h3>Suitable For</h3>
              <div class="tag-list">
                {mountain.suitable_for.map((audience: string) => (
                  <span class="tag">{audience}</span>
                ))}
              </div>
            </div>
          )}

          {mountain.history && (
            <div class="history-section">
              <h3>History</h3>
              <p>{mountain.history}</p>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 2.5 GALLERY SECTION -->
    <section class="gallery-section">
      <h2>Photo Gallery</h2>
      <div class="gallery-row">
        {displayImages.map((imageUrl, index) => (
          <div class="gallery-item">
            <img
              src={imageUrl}
              alt={`${mountain.name} - View ${index + 1}`}
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </section>

    <!-- 3. KEY INFORMATION GRID -->
    <section class="key-information">
      <h2>Key Mountain Facts & Map</h2>
      <div class="info-grid-layout">
        <!-- Location & Map -->
        <div class="info-card">
          <h3>Location & Map</h3>
          <div class="map-container">
            <img
              src={`https://api.mapbox.com/styles/v1/mapbox/outdoors-v12/static/pin-s+0f766e(${mountain.longitude},${mountain.latitude})/${mountain.longitude},${mountain.latitude},11,0/600x400@2x?access_token=pk.eyJ1IjoibWFwYm94IiwiYSI6ImNpejY4NXVycTA2emYycXBndHRqcmZ3N3gifQ.rJcFIG214AriISLbB6B5aw`}
              alt={`Map showing location of ${mountain.name}`}
              loading="lazy"
            />
          </div>
          <dl>
            <dt>Region:</dt>
            <dd>{mountain.region}{mountain.county ? `, ${mountain.county}` : ''}</dd>
            {mountain.nearest_town && (
              <>
                <dt>Nearest Town:</dt>
                <dd>{mountain.nearest_town}</dd>
              </>
            )}
            {mountain.parking_postcode && (
              <>
                <dt>Postcode for Sat-Nav:</dt>
                <dd class="postcode">{mountain.parking_postcode}</dd>
              </>
            )}
            {mountain.grid_reference && (
              <>
                <dt>OS Grid Reference:</dt>
                <dd>{mountain.grid_reference}</dd>
              </>
            )}
          </dl>
        </div>

        <!-- Weather & Conditions -->
        <div class="info-card">
          <h3>Weather & Conditions</h3>
          <div class="weather-intro">
            <p>Mountain weather can change rapidly and dramatically. Always check the forecast before setting out and be prepared for conditions to be significantly different at the summit compared to the base.</p>
          </div>
          <div class="weather-widget">
            <a href={`https://www.metoffice.gov.uk/weather/forecast/${mountain.parking_postcode || mountain.grid_reference}`} target="_blank" rel="noopener" class="btn btn-small">View Live Weather Forecast</a>
            <a href={`https://www.mountain-forecast.com/`} target="_blank" rel="noopener" class="btn btn-small">Mountain Weather Forecast</a>
          </div>
          {mountain.best_season && (
            <div class="season-info">
              <strong>Best Season:</strong> {mountain.best_season}
            </div>
          )}
          <div class="weather-tips">
            <h4>Weather Tips:</h4>
            <ul>
              <li>Summit temperatures are typically 5-10°C colder than valley floor</li>
              <li>Wind chill can make it feel significantly colder</li>
              <li>Visibility can drop to near zero in mist or cloud</li>
              <li>Always carry waterproofs, warm layers, and emergency shelter</li>
              <li>Be prepared to turn back if conditions deteriorate</li>
            </ul>
          </div>
          {mountain.weather_warnings && (
            <div class="weather-warning">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                <path d="M12 9v4"/>
                <path d="M12 17h.01"/>
              </svg>
              <p>{mountain.weather_warnings}</p>
            </div>
          )}
        </div>

        <!-- Parking & Access -->
        <div class="info-card">
          <h3>Parking & Access</h3>
          <div class="parking-intro">
            <p>Plan your arrival early, especially on weekends and during peak season, as car parks fill quickly. Always check parking restrictions and fees before you travel.</p>
          </div>
          {mountain.parking_postcode && (
            <div class="parking-detail">
              <strong>Parking Postcode:</strong>
              <span class="postcode">{mountain.parking_postcode}</span>
              <small>For sat-nav and route planning</small>
            </div>
          )}
          {mountain.parking_fees && (
            <div class="parking-detail">
              <strong>Parking Fees:</strong> {mountain.parking_fees}
            </div>
          )}
          <div class="parking-tips">
            <h4>Parking Tips:</h4>
            <ul>
              <li>Arrive before 9am on busy days to secure parking</li>
              <li>Have coins/card ready for pay-and-display machines</li>
              <li>Don't leave valuables visible in your vehicle</li>
              <li>Park considerately and don't block access roads</li>
              <li>Note your parking location for your return</li>
            </ul>
          </div>
          {mountain.toilets_available && (
            <div class="facility-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"/>
                <path d="M12 5v14"/>
              </svg>
              Toilets Available
            </div>
          )}
          {mountain.visitor_centre && (
            <div class="parking-detail">
              <strong>Visitor Centre:</strong> {mountain.visitor_centre}
            </div>
          )}
          {mountain.public_transport && (
            <div class="parking-detail">
              <strong>Public Transport:</strong> {mountain.public_transport}
            </div>
          )}
          {mountain.facilities && mountain.facilities.length > 0 && (
            <div class="facilities-list">
              <strong>Available Facilities:</strong>
              <ul>
                {mountain.facilities.map((facility: string) => (
                  <li>{facility}</li>
                ))}
              </ul>
            </div>
          )}
          <div class="emergency-contact">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <strong>Emergency: 999 or 112</strong> (Ask for Police, then Mountain Rescue)
          </div>
        </div>
      </div>
    </section>

    <!-- 3.5 INTERESTING FACTS SECTION -->
    {mountain.fun_facts && mountain.fun_facts.length > 0 && (
      <section class="interesting-facts-section">
        <h2>10 Interesting Facts About {mountain.name}</h2>
        <ul class="facts-list">
          {mountain.fun_facts.map((fact: string) => (
            <li>{fact}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- 3.6 GUIDE TO WALKING SECTION -->
    {mountain.walking_guide && (
      <section class="walking-guide-section">
        <h2>A Guide to Walking {mountain.name}</h2>
        <div class="guide-content">
          <p>{mountain.walking_guide}</p>
        </div>
      </section>
    )}

    <!-- 4. TRAIL ROUTES SECTION -->
    {mountainRoutes.length > 0 && (
      <section id="routes" class="routes-section">
        <h2>Hiking & Climbing Routes for {mountain.name}</h2>
        <p class="section-intro">Choose from multiple routes based on your experience and fitness level. Each route offers unique highlights and challenges for those exploring the mountains in the UK.</p>
        <div class="routes-container">
          {mountainRoutes.map((route: any) => (
            <div class="route-card-detailed">
              <div class="route-header">
                <h3>{route.name}</h3>
                {route.difficulty && (
                  <span class={`difficulty-badge difficulty-${route.difficulty.toLowerCase()}`}>
                    {route.difficulty}
                  </span>
                )}
              </div>

              {route.description && <p class="route-description">{route.description}</p>}

              <div class="route-stats-grid">
                {route.distance_km && (
                  <div class="stat-box">
                    <span class="stat-label">Distance</span>
                    <span class="stat-value">{route.distance_km} km</span>
                    <span class="stat-sub">({route.distance_miles} mi)</span>
                  </div>
                )}
                {route.estimated_time_hours && (
                  <div class="stat-box">
                    <span class="stat-label">Duration</span>
                    <span class="stat-value">{route.estimated_time_hours} hrs</span>
                  </div>
                )}
                {route.ascent_meters && (
                  <div class="stat-box">
                    <span class="stat-label">Elevation Gain</span>
                    <span class="stat-value">{route.ascent_meters} m</span>
                  </div>
                )}
                {route.user_rating && (
                  <div class="stat-box">
                    <span class="stat-label">Rating</span>
                    <span class="stat-value">{'⭐'.repeat(Math.round(route.user_rating))}</span>
                  </div>
                )}
              </div>

              {route.starting_point && (
                <div class="route-detail">
                  <strong>Starting Point:</strong> {route.starting_point}
                  {route.postcode && <span class="postcode"> ({route.postcode})</span>}
                </div>
              )}

              {route.highlights && route.highlights.length > 0 && (
                <div class="route-highlights">
                  <strong>Highlights:</strong>
                  <div class="highlight-tags">
                    {route.highlights.map((highlight: string) => (
                      <span class="highlight-tag">{highlight}</span>
                    ))}
                  </div>
                </div>
              )}

              {route.route_notes && (
                <div class="route-notes">
                  <strong>Route Notes:</strong> {route.route_notes}
                </div>
              )}

              {route.seasonal_notes && (
                <div class="seasonal-notes">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                  </svg>
                  <strong>Seasonal Notes:</strong> {route.seasonal_notes}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 4.5 SAFETY TIPS SECTION -->
    <section class="safety-tips-section">
      <h2>Safety Tips for Climbing {mountain.name}</h2>
      <p class="section-intro">Stay safe while climbing one of the mountains in the UK with these essential safety guidelines:</p>
      <div class="safety-grid">
        <div class="safety-tip-card">
          <h3>Weather Preparation</h3>
          <p>Always check weather forecasts before setting out. Mountain weather can change rapidly, and summit conditions are typically 5-10°C colder than valley floor with significant wind chill.</p>
        </div>
        <div class="safety-tip-card">
          <h3>Essential Equipment</h3>
          <p>Carry maps, compass or GPS, water, food, first aid kit, whistle, torch, emergency shelter, and appropriate clothing layers including waterproofs.</p>
        </div>
        <div class="safety-tip-card">
          <h3>Route Planning</h3>
          <p>Let someone know your route plan and expected return time. Stick to marked paths and be prepared to turn back if conditions deteriorate.</p>
        </div>
        <div class="safety-tip-card">
          <h3>Emergency Contact</h3>
          <p>In case of emergency, dial 999 or 112 and ask for Police, then Mountain Rescue. Know your location using grid reference or GPS coordinates.</p>
        </div>
      </div>
    </section>

    <!-- 5. THINGS TO DO -->
    {mountain.activities && Object.keys(mountain.activities).length > 0 && (
      <section class="things-to-do">
        <h2>Activities & Nearby Attractions</h2>
        <div class="activities-grid">
          {mountain.activities.hiking && (
            <div class="activity-card">
              <div class="activity-icon">🥾</div>
              <h3>Hiking & Scrambling</h3>
              <p>{mountain.activities.hiking}</p>
            </div>
          )}

          {mountain.photography_spots && mountain.photography_spots.length > 0 && (
            <div class="activity-card">
              <div class="activity-icon">📸</div>
              <h3>Photography Spots</h3>
              <ul>
                {mountain.photography_spots.map((spot: string) => (
                  <li>{spot}</li>
                ))}
              </ul>
            </div>
          )}

          {mountain.wildlife && mountain.wildlife.length > 0 && (
            <div class="activity-card">
              <div class="activity-icon">🦅</div>
              <h3>Wildlife Watching</h3>
              <ul>
                {mountain.wildlife.map((animal: string) => (
                  <li>{animal}</li>
                ))}
              </ul>
            </div>
          )}

          {mountain.activities.biking && (
            <div class="activity-card">
