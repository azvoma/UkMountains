---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found - UK Mountains Directory"
  description="The page you're looking for could not be found. Return to UK Mountains Directory home page."
>
  <div class="not-found-page">
    <div class="container">
      <div class="not-found-content">
        <div class="icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
            <circle cx="12" cy="14" r="1"></circle>
          </svg>
        </div>
        <h1>404 - Mountain Not Found</h1>
        <p class="subtitle">
          It seems you've wandered off the beaten path. The page you're looking for doesn't exist.
        </p>
        <div class="actions">
          <a href="/" class="btn btn-primary">Return Home</a>
          <a href="/about/" class="btn btn-secondary">Learn About Us</a>
        </div>
        <div class="suggestions">
          <h2>Popular Destinations</h2>
          <ul class="mountain-list">
            <li><a href="/mountain/ben-nevis/">Ben Nevis - Scotland's Highest</a></li>
            <li><a href="/mountain/snowdon/">Snowdon - Wales' Highest</a></li>
            <li><a href="/mountain/scafell-pike/">Scafell Pike - England's Highest</a></li>
            <li><a href="/mountain/helvellyn/">Helvellyn - Lake District Classic</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .not-found-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-3xl) 0;
  }

  .not-found-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .icon {
    margin-bottom: var(--spacing-xl);
    color: var(--color-neutral-400);
  }

  .not-found-content h1 {
    font-size: 2.5rem;
    color: var(--color-neutral-900);
    margin-bottom: var(--spacing-md);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--color-neutral-600);
    margin-bottom: var(--spacing-2xl);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    margin-bottom: var(--spacing-3xl);
    flex-wrap: wrap;
  }

  .suggestions {
    background: white;
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-top: var(--spacing-2xl);
  }

  .suggestions h2 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-md);
    color: var(--color-neutral-900);
  }

  .mountain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .mountain-list li {
    padding: var(--spacing-md);
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .mountain-list li:last-child {
    border-bottom: none;
  }

  .mountain-list a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    display: flex;
    align-items: center;
    transition: all var(--transition-fast);
  }

  .mountain-list a:hover {
    color: var(--color-primary-dark);
    transform: translateX(4px);
  }

  .mountain-list a::before {
    content: '⛰️';
    margin-right: var(--spacing-sm);
  }

  @media (max-width: 768px) {
    .not-found-content h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1.125rem;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .actions .btn {
      width: 100%;
    }
  }
</style>
