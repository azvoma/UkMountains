---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "UK Mountain Activities Guide | Hotels, Gear & Conditions",
  "description": "Plan your UK mountain trip: accommodation in Fort William, climbing equipment, hillwalking gear, live conditions and local guides across all four nations.",
  "url": "https://ukmountainsdirectory.co.uk/outdoor-activities/",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ukmountainsdirectory.co.uk" },
      { "@type": "ListItem", "position": 2, "name": "Outdoor Activities", "item": "https://ukmountainsdirectory.co.uk/outdoor-activities/" },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where should I stay when climbing Ben Nevis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fort William is the natural base for Ben Nevis. Options range from walker-friendly bunkhouses a short walk from town to self-catering cottages and hotels near the mountain path trailheads."
      }
    },
    {
      "@type": "Question",
      "name": "What climbing equipment do I need for UK scrambling?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For Grade 1 scrambles you need sturdy boots, a helmet, and good navigation skills. For Grade 2 and above, add a harness, rope, and protection hardware. A UK climbing shop that stocks mountain climbing equipment specifically is your best starting point."
      }
    },
    {
      "@type": "Question",
      "name": "Can I wild camp on UK mountains?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wild camping is legal in Scotland under the Land Reform Act, but in England, Wales, and Northern Ireland you need the landowner's permission. Always check local bylaws and follow the Leave No Trace principles."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need specialist travel insurance for hillwalking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard travel insurance often excludes hillwalking above a certain height or scrambling. Look for a policy that names your activity specifically and covers third-party liability, medical costs, and trip cancellation."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I check mountain weather conditions before a walk?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use the Met Office Mountain Area Forecasts or MWIS (Mountain Weather Information Service) for UK mountain conditions. In winter, check SAIS (Scottish Avalanche Information Service) for avalanche risk in Scotland."
      }
    },
  ],
};

const navPills = [
  { href: '#hire-car', label: 'Hire Car' },
  { href: '#hotels', label: 'Hotels' },
  { href: '#hillwalking', label: 'Hillwalking & Hiking' },
  { href: '#scrambling', label: 'Scrambling & Climbing' },
  { href: '#wild-camping', label: 'Wild Camping' },
  { href: '#travel-insurance', label: 'Travel Insurance' },
];

const hireCarRegions = [
  { region: 'Scottish Highlands', pickup: 'Glasgow or Inverness Airport', detail: '~2hr drive to Fort William / Ben Nevis' },
  { region: 'Snowdonia', pickup: 'Manchester or Liverpool Airport', detail: '~1.5hr drive to Pen y Pass' },
  { region: 'Lake District', pickup: 'Manchester Airport', detail: '~1.5hr drive to Wasdale / Scafell Pike' },
  { region: 'Mourne Mountains', pickup: 'Belfast Airport', detail: '~1hr drive to Newcastle, Co. Down' },
];

const hireCarComparison = [
  { company: 'Enterprise', priceFrom: '£28/day', note: 'Wide UK airport coverage' },
  { company: 'Europcar', priceFrom: '£25/day', note: 'Good one-way rental options' },
  { company: 'Hertz', priceFrom: '£32/day', note: 'Free cancellation on most rates' },
  { company: 'Sixt', priceFrom: '£30/day', note: 'Newer fleet, higher-spec options' },
];

const hotelRegions = [
  { region: 'Fort William, Scotland', priceFrom: '£70/night' },
  { region: 'Betws-y-Coed, Wales', priceFrom: '£65/night' },
  { region: 'Keswick, Lake District', priceFrom: '£80/night' },
  { region: 'Newcastle, Co. Down', priceFrom: '£60/night' },
];

const hillwalkingConditions = [
  { name: 'Ben Nevis', nation: 'Scotland', status: 'good', detail: 'Clear summit, light wind' },
  { name: 'Yr Wyddfa (Snowdon)', nation: 'Wales', status: 'caution', detail: '40mph gusts forecast above 800m' },
  { name: 'Scafell Pike', nation: 'England', status: 'good', detail: 'Dry, visibility 10km+' },
  { name: 'Slieve Donard', nation: 'Northern Ireland', status: 'avoid', detail: 'Storm warning from 2pm' },
];

const jacketComparison = [
  { brand: 'Alpkit Balance', price: '£120', rating: 4 },
  { brand: 'Berghaus Deluge Pro', price: '£90', rating: 3 },
  { brand: 'Rab Downpour Eco', price: '£75', rating: 3 },
  { brand: 'Mountain Warehouse Pakka', price: '£45', rating: 2 },
];

const accommodationListings = [
  { name: 'Ben Nevis Bunkhouse', location: 'Fort William, Scotland', desc: "Walker-friendly bunkhouse, 10 minutes from the Ben Nevis path." },
  { name: 'Pen y Pass Hostel', location: 'Snowdonia, Wales', desc: "Trailhead stay for Yr Wyddfa's Pyg and Miners' tracks." },
  { name: 'Wasdale Head Inn', location: 'Lake District, England', desc: 'Historic inn beneath Scafell Pike, boot room and drying facilities.' },
  { name: 'Donard Lodge B&B', location: 'Newcastle, Co. Down', desc: 'B&B at the base of the Mourne Mountains.' },
];

const hillwalkingLinks = [
  { label: 'Ben Nevis route guide', href: '/mountain/ben-nevis' },
  { label: 'Yr Wyddfa (Snowdon) route guide', href: '/mountain/snowdon' },
  { label: 'Scafell Pike route guide', href: '/mountain/scafell-pike' },
  { label: 'Slieve Donard route guide', href: '/mountain/slieve-donard' },
];

const winterConditions = [
  { region: 'Cairngorms', level: 'considerable' },
  { region: 'Glencoe', level: 'high' },
  { region: 'Torridon', level: 'low' },
  { region: 'Lochaber', level: 'considerable' },
];

const climbingGear = [
  { name: 'Petzl Meteor Helmet', price: '£75', pro: 'Ultralight, well ventilated', con: 'Premium price' },
  { name: 'Black Diamond Half Dome', price: '£55', pro: 'Durable, easy to adjust', con: 'Heavier on long routes' },
  { name: 'Petzl Corax Harness', price: '£50', pro: 'Comfortable, versatile', con: 'Bulkier for scrambling' },
  { name: 'Edelrid Loopo Harness', price: '£40', pro: 'Great value', con: 'Basic gear loops' },
  { name: 'DMM Shadow Harness', price: '£65', pro: 'Lightweight, scrambling-specific', con: 'Less padding on belays' },
];

const guideListings = [
  { name: 'Glenmore Lodge', location: 'Cairngorms, Scotland', desc: 'Winter skills, scrambling and mountaineering courses.' },
  { name: 'Plas y Brenin', location: 'Snowdonia, Wales', desc: 'National Mountain Centre — scrambling and navigation courses.' },
  { name: 'Lake District Mountain Guides', location: 'Cumbria, England', desc: 'Private guiding on Scafell Pike scrambles and winter routes.' },
  { name: 'Mourne Mountain Guides', location: 'Co. Down, NI', desc: 'Guided scrambling and hillwalking across the Mournes.' },
];

const campingConditions = [
  { region: 'Cairngorms', wind: '18mph', low: '3°C', sunset: '21:14' },
  { region: 'Snowdonia', wind: '12mph', low: '8°C', sunset: '21:32' },
  { region: 'Lake District', wind: '9mph', low: '9°C', sunset: '21:20' },
  { region: 'Mourne Mountains', wind: '15mph', low: '7°C', sunset: '21:05' },
];

const tentGrid = [
  { name: 'Vango Soul 100', price: '£120' },
  { name: 'Alpkit Ordos 2', price: '£180' },
  { name: 'Decathlon MT500', price: '£150' },
  { name: 'Wild Country Zephyros 1', price: '£220' },
];

const insuranceComparison = [
  { provider: 'Snowcard Insurance', coverage: 'Hillwalking & scrambling to Grade 3, medical & repatriation costs', priceFrom: '£45' },
  { provider: 'BMC Travel & Activity Insurance', coverage: 'Hillwalking, climbing & mountaineering, third-party liability', priceFrom: '£38' },
  { provider: 'Global Rescue', coverage: 'Emergency evacuation in remote areas outside the UK', priceFrom: '£89' },
  { provider: 'Battleface', coverage: 'Adventure travel with customisable activity add-ons', priceFrom: '£30' },
];

const statusLabel = { good: 'Good', caution: 'Caution', avoid: 'Avoid' };
const levelLabel = { low: 'Low', considerable: 'Considerable', high: 'High' };
---

<Layout
  title="UK Mountain Activities Guide | Hotels, Gear & Conditions"
  description="Plan your UK mountain trip: accommodation in Fort William, climbing equipment, hillwalking gear, live conditions and local guides across all four nations."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="activities-page">
    <section class="page-hero">
      <div class="container">
        <Breadcrumbs items={[
          { name: 'Home', url: '/' },
          { name: 'Outdoor Activities' }
        ]} />
        <h1>The Ultimate Guide to UK Mountain Activities</h1>
        <p class="hero-lead">
          From the Munros of the Highlands to the fells of the Lakes, this hub covers everything
          you need for a safe, rewarding trip — getting there, where to stay, hillwalking gear and
          conditions, scrambling and climbing kit, wild camping essentials, and insurance that
          actually protects you on the hill.
        </p>
        <div class="hero-pills">
          {navPills.map((p) => (
            <a class="pill" href={p.href}>{p.label}</a>
          ))}
        </div>
      </div>
    </section>

    <div class="container">
      <p class="disclosure">
        Some links on this page are affiliate links — we may earn a commission at no extra cost to
        you. Featured accommodation and guide listings are paid placements, marked as such.
      </p>

      <section class="activity-section" id="hire-car">
        <h2>Hire Car &amp; Getting There</h2>
        <p class="section-intro">
          Most UK trailheads sit well beyond the train line. A hire car is often the practical
          way to reach more than one mountain in a trip — here's where to start.
        </p>

        <h3>Getting to the Trailhead by Region</h3>
        <div class="info-grid">
          {hireCarRegions.map((r) => (
            <div class="info-card">
              <h4>{r.region}</h4>
              <p class="info-pickup">{r.pickup}</p>
              <p class="info-detail">{r.detail}</p>
            </div>
          ))}
        </div>

        <h3>Compare Car Hire Providers</h3>
        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr><th>Provider</th><th>Price from</th><th>Notes</th></tr>
            </thead>
            <tbody>
              {hireCarComparison.map((c) => (
                <tr>
                  <td>{c.company}</td>
                  <td>{c.priceFrom}</td>
                  <td>{c.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="activity-section" id="hotels">
        <h2>Hotels &amp; Accommodation Near the Mountains</h2>
        <p class="section-intro">
          Base yourself close to the mountain and start walking sooner. Search accommodation
          across all four nations, or see trailhead-specific stays under Hillwalking below.
        </p>

        <h3>Accommodation in Fort William: Where to Stay for Ben Nevis</h3>
        <p>
          Fort William is the natural base for Ben Nevis, and its accommodation reflects that —
          from budget lodges and bunkhouses to self-catering cottages a short walk from town.
          Whether you're after hotels near Ben Nevis, a cottage in Fort William, or camping sites
          around Fort William, Scotland's outdoor capital has options for every budget and every
          night before an early summit start.
        </p>

        <h3>Popular Base Towns by Region</h3>
        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr><th>Base town</th><th>Price from</th></tr>
            </thead>
            <tbody>
              {hotelRegions.map((h) => (
                <tr>
                  <td>{h.region}</td>
                  <td>{h.priceFrom}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="related-links">
          Looking for a bunkhouse right at the trailhead? See
          <a href="#hillwalking">featured trailside accommodation near Ben Nevis</a> below.
        </p>
      </section>

      <section class="activity-section" id="hillwalking">
        <h2>Hillwalking &amp; Hiking Gear + Conditions</h2>
        <p class="section-intro">
          Conditions on UK mountains can shift fast, even in summer — the right gear, and knowing
          before you go, keeps a good day good.
        </p>

        <h3>Mountain Weather &amp; Conditions Tracker</h3>
        <p class="sample-note">Sample data — swap for Met Office Mountain Area Forecasts or MWIS before launch.</p>
        <div class="conditions-grid">
          {hillwalkingConditions.map((c) => (
            <div class="condition-card">
              <p class="condition-name">{c.name}</p>
              <p class="condition-nation">{c.nation}</p>
              <p class={`condition-status status-${c.status}`}>{statusLabel[c.status]}</p>
              <p class="condition-detail">{c.detail}</p>
            </div>
          ))}
        </div>

        <h3>Waterproof Jackets: Premium vs Budget</h3>
        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Brand</th>
                <th>Price</th>
                <th>Rating</th>
              </tr>
            </thead>
            <tbody>
              {jacketComparison.map((j) => (
                <tr>
                  <td>{j.brand}</td>
                  <td>{j.price}</td>
                  <td class="stars" aria-label={`${j.rating} out of 5 stars`}>
                    {'★'.repeat(j.rating)}{'☆'.repeat(5 - j.rating)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p>
          Don't overlook eye protection — a good pair of hiking sunglasses cuts glare on exposed
          ridgelines and makes a real difference on long summer days above the treeline.
        </p>

        <h3>Featured Trailside Accommodation</h3>
        <div class="listings-grid">
          {accommodationListings.map((a) => (
            <div class="listing-card">
              <span class="listing-badge">Stay</span>
              <h4>{a.name}</h4>
              <p class="listing-location">{a.location}</p>
              <p class="listing-desc">{a.desc}</p>
            </div>
          ))}
        </div>

        <p class="related-links">
          Read our specific guides for
          {hillwalkingLinks.map((l, i) => (
            <>
              {' '}<a href={l.href}>{l.label}</a>{i < hillwalkingLinks.length - 1 ? ',' : '.'}
            </>
          ))}
        </p>
      </section>

      <section class="activity-section" id="scrambling">
        <h2>Scrambling, Climbing Equipment &amp; Local Guides</h2>
        <p class="section-intro">
          Scrambling rewards good judgement and the right kit. Check conditions, especially in
          winter, before committing to a grade above your comfort.
        </p>

        <h3>Winter Conditions &amp; Avalanche Risk</h3>
        <p class="sample-note">Sample data, Nov–Apr season only — replace with live SAIS (sais.gov.uk) data.</p>
        <div class="conditions-grid">
          {winterConditions.map((w) => (
            <div class="condition-card">
              <p class="condition-name">{w.region}</p>
              <p class={`condition-status status-${w.level === 'low' ? 'good' : w.level === 'high' ? 'avoid' : 'caution'}`}>
                {levelLabel[w.level]}
              </p>
            </div>
          ))}
        </div>

        <h3>Climbing Equipment &amp; Gear for UK Mountains</h3>
        <p>
          Whether you're after mountaineering gear for a winter ridge or a full climbing equipment
          set-up for your first Grade 1 scramble, choosing the right kit matters more in the UK's
          fast-changing weather than almost anywhere else. Look for a UK climbing shop that stocks
          mountain climbing equipment specifically, rather than generic outdoor gear — and don't
          overlook sunglasses for mountaineering, since glare off snow and wet rock catches out
          more scramblers than you'd expect.
        </p>

        <h3>Top 5 Climbing Helmets &amp; Harnesses</h3>
        <div class="listings-grid">
          {climbingGear.map((g) => (
            <div class="listing-card">
              <h4>{g.name}</h4>
              <p class="listing-price">{g.price}</p>
              <p class="listing-pro"><strong>Pros:</strong> {g.pro}</p>
              <p class="listing-con"><strong>Cons:</strong> {g.con}</p>
            </div>
          ))}
        </div>

        <h3>Local Mountain Guides &amp; Courses</h3>
        <div class="listings-grid">
          {guideListings.map((g) => (
            <div class="listing-card">
              <span class="listing-badge">Guide</span>
              <h4>{g.name}</h4>
              <p class="listing-location">{g.location}</p>
              <p class="listing-desc">{g.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="activity-section" id="wild-camping">
        <h2>Wild Camping &amp; Backpacking Essentials</h2>
        <p class="section-intro">
          A summit camp is one of the best rewards in hillwalking. Check the overnight low, the
          wind, and know local wild camping rules before you pitch.
        </p>

        <h3>Wild Camping Conditions</h3>
        <p class="sample-note">Sample data — replace with Met Office/OpenWeather plus a sunrise-sunset API.</p>
        <div class="conditions-grid">
          {campingConditions.map((c) => (
            <div class="condition-card">
              <p class="condition-name">{c.region}</p>
              <p class="condition-detail">Wind {c.wind} · Low {c.low}</p>
              <p class="condition-detail">Sunset {c.sunset}</p>
            </div>
          ))}
        </div>

        <h3>Best Beginner Lightweight Tents Under £250</h3>
        <div class="listings-grid">
          {tentGrid.map((t) => (
            <div class="listing-card">
              <h4>{t.name}</h4>
              <p class="listing-price">{t.price}</p>
            </div>
          ))}
        </div>

        <p class="related-links">
          Plan your route: <a href="/mountains/">browse all UK mountain guides</a>.
        </p>
      </section>

      <section class="activity-section" id="travel-insurance">
        <h2>Travel Insurance &amp; Safety Cover</h2>
        <p class="section-intro">
          Standard travel insurance often excludes hillwalking above a certain height, scrambling,
          or the cost of a mountain rescue. Check your policy names your activity specifically
          before you rely on it.
        </p>

        <h3>Compare Hillwalking &amp; Mountaineering Insurance</h3>
        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr><th>Provider</th><th>Covers</th><th>From</th></tr>
            </thead>
            <tbody>
              {insuranceComparison.map((i) => (
                <tr>
                  <td>{i.provider}</td>
                  <td>{i.coverage}</td>
                  <td>{i.priceFrom}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="safety-note">
        <h2>Stay Safe on the Hill</h2>
        <p>
          Mountain conditions change fast, even in summer. Always check an official forecast —
          Met Office Mountain Area Forecasts, MWIS, or SAIS in winter — before you set out. This
          page is for planning, not a substitute for your own judgement on the day.
        </p>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-container">
          <details class="faq-item">
            <summary>Where should I stay when climbing Ben Nevis?</summary>
            <p>
              Fort William is the natural base for Ben Nevis. Options range from walker-friendly
              bunkhouses a short walk from town to self-catering cottages and hotels near the
              mountain path trailheads. Book early in peak season — accommodation near Ben Nevis
              fills up fast from May to September.
            </p>
          </details>

          <details class="faq-item">
            <summary>What climbing equipment do I need for UK scrambling?</summary>
            <p>
              For Grade 1 scrambles you need sturdy boots, a helmet, and good navigation skills.
              For Grade 2 and above, add a harness, rope, and protection hardware. A UK climbing
              shop that stocks mountain climbing equipment specifically is your best starting
              point — generic outdoor stores often don't carry the technical kit you need.
            </p>
          </details>

          <details class="faq-item">
            <summary>Can I wild camp on UK mountains?</summary>
            <p>
              Wild camping is legal in Scotland under the Land Reform Act, but in England, Wales,
              and Northern Ireland you need the landowner's permission. Always check local bylaws
              and follow the Leave No Trace principles. In the Lake District and Snowdonia,
              wild camping is tolerated in some areas above the intake walls, but not officially
              permitted.
            </p>
          </details>

          <details class="faq-item">
            <summary>Do I need specialist travel insurance for hillwalking?</summary>
            <p>
              Standard travel insurance often excludes hillwalking above a certain height or
              scrambling. Look for a policy that names your activity specifically and covers
              third-party liability, medical costs, and trip cancellation. Providers like Snowcard
              and BMC offer hillwalking and mountaineering cover tailored to UK mountains.
            </p>
          </details>

          <details class="faq-item">
            <summary>Where can I check mountain weather conditions before a walk?</summary>
            <p>
              Use the Met Office Mountain Area Forecasts or MWIS (Mountain Weather Information
              Service) for UK mountain conditions. In winter, check SAIS (Scottish Avalanche
              Information Service) for avalanche risk in Scotland. Always check the forecast on
              the morning of your walk, not the night before — mountain weather can change
              overnight.
            </p>
          </details>

          <details class="faq-item">
            <summary>What's the best way to get to UK trailheads without a car?</summary>
            <p>
              Some trailheads are reachable by public transport — the Snowdon Mountain Railway
              and Jacobite train to Fort William are notable examples — but most require a hire
              car or taxi from the nearest station. Check our hire car section for the closest
              airports and drive times to each region.
            </p>
          </details>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .activities-page {
    background: var(--color-neutral-50);
  }

  /* ── Hero ── */
  .page-hero {
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
    padding: var(--spacing-3xl) 0;
    text-align: center;
  }

  :global(.page-hero .breadcrumb-list) {
    justify-content: center;
  }

  .page-hero h1 {
    color: white;
    font-size: 2.75rem;
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero-lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.2rem;
    max-width: 680px;
    margin: 0 auto var(--spacing-xl);
    line-height: 1.7;
  }

  .hero-pills {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .pill {
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    color: white;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-full);
    padding: var(--spacing-sm) var(--spacing-lg);
    transition: background var(--transition-fast);
  }

  .pill:hover {
    background: rgba(255, 255, 255, 0.25);
    color: white;
  }

  .pill:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  /* ── Disclosure ── */
  .disclosure {
    font-size: 0.85rem;
    color: var(--color-neutral-500);
    text-align: center;
    padding: var(--spacing-lg) var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  /* ── Section cards ── */
  .activity-section {
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-bottom: var(--spacing-xl);
  }

  .activity-section h2 {
    font-size: 2rem;
    color: var(--color-neutral-900);
    margin-bottom: var(--spacing-md);
  }

  .activity-section h3 {
    font-size: 1.35rem;
    color: var(--color-neutral-900);
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .section-intro {
    font-size: 1.05rem;
    color: var(--color-neutral-600);
